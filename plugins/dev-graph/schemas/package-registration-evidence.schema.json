{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package-registration-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_contract", "status", "issued_at",
    "feature_package_id", "parent_feature", "source_digest", "node_ids",
    "immutable_receipt_path", "immutable_receipt_sha256", "output_path",
    "graph_revision", "graph_sha256", "c11_readiness_digest",
    "implementation_readiness_status", "implementation_readiness_source_digest",
    "binding_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_contract": {"const": "package-registration-revalidation/v1"},
    "status": {"const": "revalidated"},
    "issued_at": {"type": "string", "format": "date-time"},
    "feature_package_id": {"type": "string", "pattern": "^feature-package/[A-Za-z0-9._/-]+$"},
    "parent_feature": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "node_ids": {
      "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "immutable_receipt_path": {"$ref": "#/$defs/repoRelative"},
    "immutable_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "output_path": {"$ref": "#/$defs/repoRelative"},
    "graph_revision": {"type": "integer", "minimum": 1},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "c11_readiness_digest": {"$ref": "#/$defs/sha256"},
    "implementation_readiness_status": {"const": "complete"},
    "implementation_readiness_source_digest": {"$ref": "#/$defs/sha256"},
    "binding_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repoRelative": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
