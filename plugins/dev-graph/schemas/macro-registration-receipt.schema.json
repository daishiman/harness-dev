{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macro-registration-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "owner", "operation", "status", "applied_at", "dry_run", "idempotent",
    "source_digest", "intent_digest", "candidate_graph_digest", "candidate_nodes_digest", "candidate_node_ids", "graph_path",
    "graph_revision_before", "graph_revision_after", "graph_sha256_after", "validation", "write_count"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "owner": {"const": "C02/run-dev-graph-node"},
    "operation": {"const": "apply_macro_decomposition"},
    "status": {"const": "applied"},
    "applied_at": {"type": "string", "format": "date-time"},
    "dry_run": {"const": false},
    "idempotent": {"type": "boolean"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_graph_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_nodes_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_node_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "graph_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "graph_revision_before": {"type": "integer", "minimum": 0},
    "graph_revision_after": {"type": "integer", "minimum": 0},
    "graph_sha256_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "valid", "implementation_readiness", "missing_sections", "violations"],
      "properties": {
        "authority": {"const": "C11/validate-graph-schema.py"},
        "valid": {"const": true},
        "implementation_readiness": {"const": "complete"},
        "missing_sections": {"type": "array", "maxItems": 0},
        "violations": {"type": "array", "maxItems": 0}
      }
    },
    "write_count": {"type": "integer", "minimum": 0}
  }
}
