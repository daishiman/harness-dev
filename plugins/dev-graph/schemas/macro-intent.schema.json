{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macro-intent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "project_id", "source_digest", "architecture", "features"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observed_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_node_id", "title", "artifact_subtypes", "domain", "resource_scope"],
      "properties": {
        "graph_node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "title": {"type": "string", "minLength": 1},
        "artifact_subtypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["frontend", "backend", "infrastructure", "data", "security"]}
        },
        "domain": {"type": "string", "minLength": 1},
        "resource_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["graph_node_id", "title", "domain", "purpose", "goal", "scope_in", "scope_out", "acceptance", "depends_on", "resource_scope"],
        "properties": {
          "graph_node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "title": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "scope_in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "scope_out": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}},
          "resource_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
