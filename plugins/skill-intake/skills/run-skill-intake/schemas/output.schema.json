{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness/run-skill-intake/orchestrator-trace.schema.json",
  "title": "orchestrator-trace.json",
  "description": "11 phase 委譲結果のトレース。各 phase の delegateType/delegateName 実行結果と最終成果物 URI を保持する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "workflow_status", "phases"],
  "allOf": [
    {
      "$comment": "in_progress / completed は 11 phase を通った trace と成果物を持つ。failed (SKILL.md の「失敗からの再開」) は FAIL 行で止まった途中の trace なので、件数と artifacts を要求しない。",
      "if": {"properties": {"workflow_status": {"enum": ["in_progress", "completed"]}}},
      "then": {"required": ["artifacts"], "properties": {"phases": {"minItems": 11}}}
    }
  ],
  "properties": {
    "session_id": {"type": "string"},
    "workflow_status": {"type": "string", "enum": ["in_progress", "completed", "failed"]},
    "topic_hint": {"type": "string"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "description": "phase attempt の append-only trace。in_progress / completed では 11 件以上 (Gate A retry の P4-P8 attempt や、失敗からの再開の FAIL 行と attempt+1 で 11 件を超え得る)。failed では FAIL 行で終わる途中までの attempt。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "attempt", "status", "delegateType", "delegateName", "started_at", "finished_at", "handoff_path", "handoff_sha256", "exit_code"],
        "properties": {
          "id": {"type": "string"},
          "attempt": {"type": "integer", "minimum": 1},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIP", "RETRY"]},
          "delegateType": {"type": "string", "enum": ["skill", "agent"]},
          "delegateName": {"type": "string"},
          "delegateSkill": {"type": ["string", "null"]},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "handoff_path": {"type": ["string", "null"]},
          "handoff_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "exit_code": {"type": "integer"},
          "skip_reason": {"type": "string"},
          "retry_reason": {"type": "string"},
          "exit_hook": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string"},
              "status": {"type": "string", "enum": ["RUNNING", "PASS", "FAIL"]},
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"type": "string"},
                    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                  }
                }
              }
            },
            "allOf": [
              {
                "$comment": "RUNNING / PASS の hook は入力・出力の evidence を1件以上持つ。FAIL の hook (exitHook の失敗で止まった attempt) は evidence を任意にする (verifier も成功 evidence を要求しない)。",
                "if": {"properties": {"status": {"enum": ["RUNNING", "PASS"]}}},
                "then": {"required": ["evidence"], "properties": {"evidence": {"minItems": 1}}}
              }
            ]
          },
          "output_schema": {"type": "string"},
          "artifact_path": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intake_md", "intake_json"],
      "properties": {
        "intake_md": {"type": "string"},
        "intake_json": {"type": "string"},
        "notion_url": {"type": "string"}
      }
    }
  }
}
