{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-workflow-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-skill-intake",
  "skill": "run-skill-intake",
  "description": "Main contextが推測補完なしのintake-request.jsonと実行previewを先に作成・guard・提示する。11 phaseのSkill/SubAgent委譲とNotion公開はlight/standard/detailed選択後だけ起動し、accept-as-isではphase実行0でrequest snapshotをローカルhandoffする。",
  "phases": [
    {"id": "P1-kickoff", "step": 1, "title": "Phase 1: kickoff", "dependsOn": [], "delegateType": "skill", "delegateName": "run-intake-kickoff", "delegateSkill": "run-intake-kickoff", "resourceIds": ["ref-handoff-contract", "ref-workflow-sequence"], "fatal_exit_codes": [2, 3]},
    {"id": "P2-assumption", "step": 2, "title": "Phase 2: assumption (仮説生成・検証)", "dependsOn": ["P1-kickoff"], "delegateType": "agent", "delegateName": "skill-intake-assumption-challenger", "delegateSkill": null, "outputSchemaId": "schema-assumption", "resourceIds": ["ref-workflow-sequence", "schema-assumption"], "fatal_exit_codes": [2, 3]},
    {"id": "P3-profile", "step": 3, "title": "Phase 3: vocabulary profile 確定", "dependsOn": ["P2-assumption"], "delegateType": "agent", "delegateName": "skill-intake-user-profiler", "delegateSkill": null, "outputSchemaId": "schema-profile", "resourceIds": ["ref-workflow-sequence", "schema-profile"], "fatal_exit_codes": [2, 3]},
    {"id": "P4-interview", "step": 4, "title": "Phase 4: 5 軸シート充足", "dependsOn": ["P3-profile"], "delegateType": "skill", "delegateName": "run-intake-interview", "delegateSkill": "run-intake-interview", "resourceIds": ["ref-handoff-contract"], "fatal_exit_codes": [2, 3]},
    {"id": "P5-excavation", "step": 5, "title": "Phase 5: 抽象回答の深掘り", "dependsOn": ["P4-interview"], "skipWhen": "interview.json.needs_excavation=false", "skipReason": "needs_excavation=false", "delegateType": "agent", "delegateName": "skill-intake-purpose-excavator", "delegateSkill": null, "outputSchemaId": "schema-purpose", "resourceIds": ["schema-purpose"], "fatal_exit_codes": [2, 3]},
    {"id": "P6-options", "step": 6, "title": "Phase 6: 外部連携選択肢", "dependsOn": ["P5-excavation"], "delegateType": "skill", "delegateName": "run-intake-option-catalog", "delegateSkill": "run-intake-option-catalog", "resourceIds": [], "fatal_exit_codes": [2, 3]},
    {"id": "P7-visualize", "step": 7, "title": "Phase 7: 図解配置", "dependsOn": ["P6-options"], "delegateType": "skill", "delegateName": "run-intake-visualize", "delegateSkill": "run-intake-visualize", "resourceIds": [], "fatal_exit_codes": [2, 3]},
    {"id": "P8-summary", "step": 8, "title": "Phase 8: summary 抽出", "dependsOn": ["P7-visualize"], "retryOn": "summary.json.gate_a=denied", "retryTo": "P4-interview", "maxRetries": 2, "delegateType": "agent", "delegateName": "skill-intake-summarizer", "delegateSkill": null, "outputSchemaId": "schema-summary", "resourceIds": ["schema-summary"], "fatal_exit_codes": [2, 3]},
    {"id": "P9-finalize", "step": 9, "title": "Phase 9: intake.md / intake.json 生成 → post-finalize 計測・question-bank preview", "dependsOn": ["P8-summary"], "exitHook": "measure-and-preview-self-update-inline", "delegateType": "skill", "delegateName": "run-intake-finalize", "delegateSkill": "run-intake-finalize", "resourceIds": ["ref-handoff-contract", "script-measure-value-realized", "script-update-question-bank"], "fatal_exit_codes": [2, 3]},
    {"id": "P10-notion", "step": 10, "title": "Phase 10: Notion 公開 (指定 page PATCH / fidelity-guard 経由)", "dependsOn": ["P9-finalize"], "delegateType": "skill", "delegateName": "run-notion-intake-publish", "delegateSkill": "run-notion-intake-publish", "resourceIds": [], "fatal_exit_codes": [2, 3]},
    {"id": "P11-next-action", "step": 11, "title": "Phase 11: harness-creator 引き渡しモード判定 (Notion 公開後)", "dependsOn": ["P10-notion"], "exitHook": "validate-task-graph-progress", "delegateType": "skill", "delegateName": "run-intake-next-action", "delegateSkill": "run-intake-next-action", "resourceIds": ["script-validate-task-graph-progress"], "fatal_exit_codes": [1, 2, 3]}
  ],
  "resources": [
    {"id": "schema-intake-request", "kind": "schema", "path": "./schemas/intake-request.schema.json", "phaseIds": []},
    {"id": "ref-handoff-contract", "kind": "reference", "path": "./references/handoff-contract.md", "phaseIds": ["P1-kickoff", "P4-interview", "P9-finalize"]},
    {"id": "ref-workflow-sequence", "kind": "reference", "path": "./references/workflow-sequence.md", "phaseIds": ["P1-kickoff", "P2-assumption", "P3-profile"]},
    {"id": "schema-orchestrator-trace", "kind": "schema", "path": "./schemas/output.schema.json", "phaseIds": []},
    {"id": "schema-assumption", "kind": "schema", "path": "./schemas/phase2-assumption.schema.json", "phaseIds": ["P2-assumption"]},
    {"id": "schema-profile", "kind": "schema", "path": "./schemas/phase3-profile.schema.json", "phaseIds": ["P3-profile"]},
    {"id": "schema-purpose", "kind": "schema", "path": "./schemas/phase5-purpose.schema.json", "phaseIds": ["P5-excavation"]},
    {"id": "schema-summary", "kind": "schema", "path": "./schemas/phase8-summary.schema.json", "phaseIds": ["P8-summary"]},
    {"id": "script-measure-value-realized", "kind": "script", "path": "../../scripts/measure_value_realized.py", "phaseIds": ["P9-finalize"]},
    {"id": "script-update-question-bank", "kind": "script", "path": "../../scripts/update_question_bank.py", "phaseIds": ["P9-finalize"]},
    {"id": "script-validate-task-graph-progress", "kind": "script", "path": "./scripts/validate-task-graph-progress.py", "phaseIds": ["P11-next-action"]}
  ]
}
