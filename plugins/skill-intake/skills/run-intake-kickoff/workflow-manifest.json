{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-intake-kickoff",
  "skill": "run-intake-kickoff",
  "description": "intake セッション最初の phase。pattern / depth / pain ranking 3 軸を AskUserQuestion で確定し kickoff.json を生成する。",
  "phases": [
    {
      "id": "P1-pattern",
      "step": 1,
      "title": "pattern (A-E) 判定",
      "gate": "C1",
      "dependsOn": [],
      "entryHook": "load-pattern-catalog",
      "exitHook": null,
      "resourceIds": ["ref-pattern-catalog"],
      "fatal_exit_codes": [2]
    },
    {
      "id": "P2-depth",
      "step": 2,
      "title": "depth (quick/standard/detailed) 確定",
      "gate": "C2",
      "dependsOn": ["P1-pattern"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": ["ref-depth-criteria"],
      "fatal_exit_codes": [2]
    },
    {
      "id": "P3-pain",
      "step": 3,
      "title": "pain ranking 収集 (task / frequency / minutes)",
      "gate": "C3",
      "dependsOn": ["P2-depth"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": ["ref-pain-ranking"],
      "fatal_exit_codes": [2]
    },
    {
      "id": "P4-emit",
      "step": 4,
      "title": "kickoff.json 生成と validate-kickoff-json.py 実行",
      "gate": "C4",
      "dependsOn": ["P3-pain"],
      "entryHook": null,
      "exitHook": "validate-kickoff-json",
      "resourceIds": ["schema-kickoff"],
      "fatal_exit_codes": [2, 3]
    }
  ],
  "resources": [
    {"id": "ref-pattern-catalog", "kind": "reference", "path": "./references/pattern-catalog.md", "phaseIds": ["P1-pattern"]},
    {"id": "ref-depth-criteria", "kind": "reference", "path": "./references/depth-criteria.md", "phaseIds": ["P2-depth"]},
    {"id": "ref-pain-ranking", "kind": "reference", "path": "./references/pain-ranking-template.md", "phaseIds": ["P3-pain"]},
    {"id": "schema-kickoff", "kind": "schema", "path": "./schemas/output.schema.json", "phaseIds": ["P4-emit"]}
  ]
}
