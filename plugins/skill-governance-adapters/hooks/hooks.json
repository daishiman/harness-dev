{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/build-external-intelligence-context.py\"",
            "timeout": 8,
            "statusMessage": "Searching reusable project intelligence"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/build-external-mutation-guard.py\" hook-confirm",
            "timeout": 8,
            "statusMessage": "Binding external mutation confirmation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/build-external-mutation-guard.py\" pretool",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
