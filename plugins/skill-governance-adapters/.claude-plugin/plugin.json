{
  "name": "skill-governance-adapters",
  "version": "0.1.8",
  "description": "外部 CI/IDE 連携アダプタを提供する governance プラグイン。Notion・GitHub Actions・VS Code との橋渡しスクリプトを束ね、skill governance の通知・公開・診断を一元化する。改善要望は `/run-skill-feedback skill-governance-adapters` で投入可能 (SSOT: harness-creator/skills/run-skill-feedback、symlink 配備)。",
  "author": {
    "name": "harness maintainers"
  },
  "keywords": [
    "skill-governance",
    "adapter",
    "sink",
    "route",
    "dispatch"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/build-external-intelligence-context.py\"",
            "timeout": 8,
            "statusMessage": "Searching reusable project intelligence"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/scripts/build-external-mutation-guard.py\" hook-confirm",
            "timeout": 8,
            "statusMessage": "Binding external mutation confirmation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/scripts/build-external-mutation-guard.py\" pretool",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
