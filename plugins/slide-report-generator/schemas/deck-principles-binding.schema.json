{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deck-principles-binding.schema.json",
  "title": "資料作成原則 consumer binding",
  "description": "consumer registry と全原則の排他的分類を定義する versioned contract。consumer 件数や principle 件数は固定しない。",
  "type": "object",
  "required": ["schema_version", "consumer_scope", "consumers", "mapped_by_filter", "already_enforced", "out_of_scope"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "_meta": {"type": "object"},
    "schema_version": {"type": "integer", "const": 1},
    "consumer_scope": {
      "type": "object",
      "required": ["owner_skills", "excluded_agents"],
      "additionalProperties": false,
      "properties": {
        "owner_skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "excluded_agents": {
          "type": "array",
          "items": {"$ref": "#/definitions/excluded_agent"}
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/consumer"}
    },
    "mapped_by_filter": {"$ref": "#/definitions/ref_partition"},
    "already_enforced": {
      "type": "object",
      "required": ["map"],
      "additionalProperties": false,
      "properties": {
        "_note": {"type": "string"},
        "map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["refs", "owner"],
            "additionalProperties": false,
            "properties": {
              "refs": {"$ref": "#/definitions/principle_refs"},
              "owner": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "out_of_scope": {
      "type": "object",
      "required": ["refs", "reason"],
      "additionalProperties": false,
      "properties": {
        "_note": {"type": "string"},
        "refs": {"$ref": "#/definitions/principle_refs"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "definitions": {
    "excluded_agent": {
      "type": "object",
      "required": ["id", "reason", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "principle_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DP-[0-9]{3}$"}
    },
    "ref_partition": {
      "type": "object",
      "required": ["refs"],
      "additionalProperties": false,
      "properties": {
        "_note": {"type": "string"},
        "refs": {"$ref": "#/definitions/principle_refs"}
      }
    },
    "consumer": {
      "type": "object",
      "required": ["id", "plugin", "prompt", "when", "select", "intent", "core_refs", "existing_receiver", "run_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "plugin": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "prompt": {"type": "string", "minLength": 1},
        "when": {"type": "string", "minLength": 1},
        "select": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "intent": {"type": "string", "minLength": 1},
        "core_refs": {"$ref": "#/definitions/principle_refs"},
        "existing_receiver": {"type": "string", "minLength": 1},
        "run_by": {"type": "string", "enum": ["agent", "orchestrator"]},
        "unit_caution": {"type": "string", "minLength": 1},
        "vendored_catalog": {"type": "string", "minLength": 1}
      }
    }
  }
}
