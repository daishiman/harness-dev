    "slide_types": "schemas/structure.schema.json#/$defs/slideTypeEnum/enum",
    "skeletons": "assets/slide-templates/layout-*.html",
    "geometry": "assets/slide-templates/frame-contract.json",
    "colors": "vendor/scripts/style-builder.cjs#SPEC.colors"
  },
  "media_override": {
    "note": "visual-strategist が当該セクションの差し込み物を codex-image に決めた場合、slideType の既定ひな形ではなく画像系ひな形へ載せ替える。載せ替え先は画像の役割で決まる: 面いっぱい=layout-image-full / 文と並置=layout-image-side / 複数枚の並置=layout-image-grid。slideType は据え置き (構成の意味は変わらないため)。",
    "targets": [
      "layout-image-full",
      "layout-image-side",
      "layout-image-grid"
    ]
  },
