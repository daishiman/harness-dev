{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-slide-report-modify",
  "skill": "run-slide-report-modify",
  "description": "Main contextが既存成果物を最小局所修正してactual artifactを先に提示する。R1/R2/R3（Task fork、mode別再評価、有界修正）はlight/standard/detailed選択後だけ起動し、accept-as-isではphase実行0でhandoff完了する。",
  "phases": [
    {
      "id": "R1-identify-target",
      "step": 1,
      "title": "setup-playwright.py でplatform別Chromiumをplugin-localへ復元・検査し、修正対象成果物のパスと output_mode を特定して修正指示を mode 別 6 区分に分類、validate-output-mode.py で mode/reportType の値域整合を送信前検証",
      "gate": "C1",
      "dependsOn": [],
      "entryHook": null,
      "exitHook": "validate-output-mode",
      "resourceIds": [
        "ref-modification-rules",
        "ref-report-modification-rules",
        "schema-structure",
        "schema-report-structure",
        "script-setup-playwright",
        "script-validate-output-mode"
      ],
      "fatal_exit_codes": [
        2
      ]
    },
    {
      "id": "R2-local-modify",
      "step": 2,
      "title": "slide-report-modifier を name 起動 (isolation: fork) し mode 分岐で規範に従い指定箇所のみを局所差分修正。slide=modification-rules.md CONST_001-013 で index.html⇔structure.* 同期、report=report-modification-rules.md RCONST_001-013 で report-structure.json を正に編集し render-report.js で report.html を再レンダ・sidecar 履歴追記",
      "gate": "C2",
      "dependsOn": [
        "R1-identify-target"
      ],
      "entryHook": null,
      "exitHook": "sync-checklist",
      "resourceIds": [
        "ref-modification-rules",
        "ref-report-modification-rules",
        "schema-structure",
        "schema-report-structure",
        "script-render-report"
      ],
      "fatal_exit_codes": [
        2
      ]
    },
    {
      "id": "R3-re-evaluate",
      "step": 3,
      "title": "mode 別に修正後を再評価し修正レポートを生成、未達なら R2 へ差し戻し。slide=verify-slides.js系、report=render-report.js 再レンダ整合＋verify-report-runtime.js実描画bundle＋validate-report-visual.py --structure --require-structure＋mode-aware deck-evaluator",
      "gate": "C3",
      "dependsOn": [
        "R2-local-modify"
      ],
      "entryHook": "verify-slides|render-report",
      "exitHook": "slide:verify-slides+evaluate-deck+validate-print | report:render-report+verify-report-runtime+validate-report-visual+deck-evaluator",
      "resourceIds": [
        "script-verify-slides",
        "script-evaluate-deck",
        "script-validate-print",
        "script-render-report",
        "script-verify-report-runtime",
        "script-validate-report-visual",
        "script-setup-playwright",
        "script-validate-output-mode"
      ],
      "fatal_exit_codes": [
        1,
        2,
        3
      ]
    }
  ],
  "resources": [
    {
      "id": "ref-modification-rules",
      "kind": "reference",
      "path": "./references/modification-rules.md",
      "phaseIds": [
        "R1-identify-target",
