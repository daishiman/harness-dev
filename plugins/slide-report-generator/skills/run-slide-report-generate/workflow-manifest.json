{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-slide-report-generate",
  "skill": "run-slide-report-generate",
  "description": "output_mode(slide/report)を推定し、実際に開けるHTMLを生成して最小guard後に先に提示する。利用者が診断/改善を選んだ場合のみ、15 agent・30種思考法・最大3周のsemantic reviewを起動する。",
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "phases": [
    {
      "id": "R1-hearing-mode",
      "step": 1,
      "title": "setup-playwright.py でplatform別Chromiumをplugin-localへ復元・検査した上で、hearing-facilitator が output_mode/reportType/読者/長さ/ビジュアル方針と読者価値ブリーフ(対象範囲・共有課題・読後の変化・専門の橋・深さの証拠・正式タイトル制約)を確定し、validate-output-mode.py で送信前値域検証(fail-closed)して下流へ一貫伝播",
      "gate": "C1",
      "dependsOn": [],
      "entryHook": null,
      "exitHook": "validate-output-mode",
      "resourceIds": [
        "ref-resource-map",
        "glue-setup-playwright",
        "glue-validate-output-mode",
        "schema-structure",
        "schema-report-structure"
      ],
      "fatal_exit_codes": [
        2
      ]
    },
    {
      "id": "R2-structure-gate",
      "step": 2,
      "title": "構成設計に入る前に情報優先度を確定し(文脈→棚卸し→グループ化→順位→削減→加工→形式選定を information-priority-map.json へ宣言、validate-information-priority.py で順位が装飾に先行することを fail-closed 検証)、確定 mode と読者価値ブリーフで structure-designer/report-structure-designer(+d3/data-visualizer/visual-strategist) が、想定読者内で共有される入口→専門解決→自分ごと化の橋を設計する。正式タイトル制約と根拠完全性を維持し、structure-validator + validate-structure.js の仕様確定ゲートで P3 進入を制御(PASS→R3 / WARN→承認後 R3 / FAIL→R2 差戻し)",
      "gate": "C2",
      "dependsOn": [
        "R1-hearing-mode"
      ],
      "entryHook": null,
      "exitHook": "validate-structure",
      "resourceIds": [
        "ref-information-priority-rules",
        "glue-validate-information-priority",
        "ref-structure-design-rules",
        "ref-report-structure-types",
        "ref-d3-diagram-rules",
        "ref-data-visualization-rules",
        "ref-diagram-type-crosswalk",
        "ref-diagram-style-tokens",
        "ref-diagram-layout-contract",
        "ref-diagram-information-contract",
        "schema-structure",
        "schema-report-structure",
        "vendor-validate-structure",
        "vendor-workflow-manager",
        "ref-slide-skeleton-registry"
      ],
      "fatal_exit_codes": []
    },
    {
      "id": "R3-generate-minimal-guard",
      "step": 3,
      "title": "選択した生成経路で実HTMLを作り、UTF-8 parse/open・空/破損・secret混入・不可逆処理有無のclass別最小guardだけを通す。意味評価、全agent統率、30種思考法、改善周回は行わない",
      "gate": "C3",
      "dependsOn": [
        "R2-structure-gate"
      ],
      "entryHook": null,
      "exitHook": "hook-postgen-eval:minimal-artifact-guard",
      "resourceIds": [
        "ref-html-generation-rules",
        "ref-ai-image-pipeline",
        "ref-diagram-type-crosswalk",
        "ref-diagram-style-tokens",
        "ref-diagram-layout-contract",
        "ref-diagram-information-contract",
        "ref-diagram-skeleton-slide",
        "ref-diagram-skeleton-report",
        "ref-slide-skeleton-registry",
        "ref-slide-frame-contract",
        "schema-structure",
        "schema-report-structure",
        "vendor-render-slide",
        "vendor-render-report",
        "vendor-mermaid-render",
        "vendor-build-image-prompts",
        "vendor-generate-images-codex",
        "vendor-build-deck-html",
        "glue-validate-slide-skeleton",
        "vendor-workflow-manager"
      ],
      "fatal_exit_codes": [1]
    },
    {
      "id": "R4-artifact-present-handoff",
      "step": 4,
      "title": "実成果物のpathと開き方を利用者に提示",
      "gate": "delivery",
      "dependsOn": ["R3-generate-minimal-guard"],
      "events": ["artifact_created", "minimal_guard_passed", "artifact_presented"],
      "completion_gate": "artifact_created_at < artifact_presented_at AND minimal_guard=PASS",
      "exitHook": null,
      "resourceIds": [],
      "fatal_exit_codes": []
    },
    {
      "id": "R5-diagnostic-choice",
      "step": 5,
      "title": "現物提示後に診断・改善の深度を利用者が選択",
      "dependsOn": ["R4-artifact-present-handoff"],
      "choices": ["accept-as-is", "light", "standard", "detailed"],
      "release_event": "explicit-only",
      "exhaustive_event": "explicit-only",
      "accept_as_is_evaluator_contexts": 0,
      "accept_as_is_improver_contexts": 0,
      "auto_release": false,
      "auto_exhaustive": false,
      "resourceIds": [],
      "fatal_exit_codes": []
    },
    {
      "id": "R6-selected-semantic-review",
      "step": 6,
      "title": "利用者選択時のみ15 agent・30種思考法・最大3周の評価改善",
      "dependsOn": ["R5-diagnostic-choice"],
      "default_on": false,
      "condition": "user_choice_recorded in [light,standard,detailed]",
      "evaluator_contexts_when_accept_as_is": 0,
      "improver_contexts_when_accept_as_is": 0,
      "agent_roster_count": 15,
      "thought_method_count": 30,
      "max_iterations": 3,
      "entry_gate": "artifact_created_at < artifact_presented_at < semantic_evaluator_started_at",
      "exitHook": "slide:evaluate-deck | report:validate-report-visual",
      "resourceIds": [
        "ref-layout-optimization-rules",
        "ref-ui-quality-checklist",
        "ref-report-quality-checklist",
        "ref-deck-evaluation-rubric",
        "glue-setup-playwright",
        "glue-validate-report-visual",
        "glue-validate-svg-diagram",
        "glue-validate-diagram-information",
        "glue-validate-slide-layout",
        "glue-validate-report-layout",
        "vendor-verify-slides",
        "vendor-evaluate-deck",
        "vendor-validate-print",
        "vendor-verify-report-runtime",
        "vendor-validate-ai-image-assets",
        "prompt-R3-agent-layout-optimizer",
        "prompt-R3-agent-ui-quality-reviewer",
        "prompt-R3-agent-report-quality-reviewer",
        "prompt-R3-agent-deck-evaluator"
      ],
      "fatal_exit_codes": []
    }
  ],
