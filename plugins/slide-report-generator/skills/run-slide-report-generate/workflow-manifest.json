{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-slide-report-generate",
  "skill": "run-slide-report-generate",
  "description": "output_mode(slide/report) と読者価値ブリーフを確定し、入口は想定読者内の共有課題・変化、本文は根拠・手順まで深く設計する。mode は送信前に fail-closed 検証し、意匠/技術コアを共有したまま構成着手前の情報優先度ゲート→構成設計→仕様確定ゲート→生成(HTML/決定論 render-slide.cjs/report render-report.js/Codex 画像)→生成後評価(30 種思考法)まで 15 agent を Task name 起動で統率する主オーケストレータ。",
  "phases": [
    {
      "id": "R1-hearing-mode",
      "step": 1,
      "title": "setup-playwright.py でplatform別Chromiumをplugin-localへ復元・検査した上で、hearing-facilitator が output_mode/reportType/読者/長さ/ビジュアル方針と読者価値ブリーフ(対象範囲・共有課題・読後の変化・専門の橋・深さの証拠・正式タイトル制約)を確定し、validate-output-mode.py で送信前値域検証(fail-closed)して下流へ一貫伝播",
      "gate": "C1",
      "dependsOn": [],
      "entryHook": null,
      "exitHook": "validate-output-mode",
      "resourceIds": [
        "ref-resource-map",
        "glue-setup-playwright",
        "glue-validate-output-mode",
        "schema-structure",
        "schema-report-structure"
      ],
      "fatal_exit_codes": [
        2
      ]
    },
    {
      "id": "R2-structure-gate",
      "step": 2,
      "title": "構成設計に入る前に情報優先度を確定し(文脈→棚卸し→グループ化→順位→削減→加工→形式選定を information-priority-map.json へ宣言、validate-information-priority.py で順位が装飾に先行することを fail-closed 検証)、確定 mode と読者価値ブリーフで structure-designer/report-structure-designer(+d3/data-visualizer/visual-strategist) が、想定読者内で共有される入口→専門解決→自分ごと化の橋を設計する。正式タイトル制約と根拠完全性を維持し、structure-validator + validate-structure.js の仕様確定ゲートで P3 進入を制御(PASS→R3 / WARN→承認後 R3 / FAIL→R2 差戻し)",
      "gate": "C2",
      "dependsOn": [
        "R1-hearing-mode"
      ],
      "entryHook": null,
      "exitHook": "validate-structure",
      "resourceIds": [
        "ref-information-priority-rules",
        "glue-validate-information-priority",
        "ref-structure-design-rules",
        "ref-report-structure-types",
        "ref-d3-diagram-rules",
        "ref-data-visualization-rules",
        "ref-diagram-type-crosswalk",
        "ref-diagram-style-tokens",
        "ref-diagram-layout-contract",
        "ref-diagram-information-contract",
        "schema-structure",
        "schema-report-structure",
        "vendor-validate-structure",
        "vendor-workflow-manager",
        "ref-slide-skeleton-registry"
      ],
      "fatal_exit_codes": []
    },
    {
      "id": "R3-generate-evaluate",
      "step": 3,
      "title": "経路(slide LLM=html-generator / slide 決定論=slide-renderer+render-slide.cjs / report=report-composer+render-report.js(+mermaid-render.js) / 画像明示=ai-image-diagram-producer)で成果物を生成し、slide は ui-quality-reviewer(必須)/layout-optimizer(崩れ検出面がある場合は必須。両者とも「必要に応じ」ではない=呼ばれない agent のチェックリストは発火しない) + verify-slides.js/validate-slide-layout.js(L0-L9 実描画契約。hook-postgen-eval が生成検知時に非 strict で機械実行し L8 充填率/L9 縦の残余は観測、L1/L2/L3/L7/L8-font の error は即修正)/evaluate-deck.js/validate-print.js、report は verify-report-runtime.js で899/900/901/1024/1366/1600px+printの実描画bundleを生成し、そのbundleを必須入力とする report-quality-reviewer が補正し、bundleを取らない静的ゲート validate-report-visual.py が構造正本に対して検査する(静的側は bundle 欠落を検出しないので生成を省略しない)。加えて両モードで validate-svg-diagram.py --check-grid --strict (D0-D23 図解の静的契約。hook-postgen-eval が生成検知時に機械実行し warning も出荷前に停止する) と validate-diagram-information.py (I1-I5 + 型別スロット=図が図として成立する下限。同じく hook が機械実行する。warning は語彙近似ゆえ合否に入れず読んで判断する対象で、error は参照の取りこぼし I-ER-REF と孤立節点 I-REL-ISO の 2 件だけ=構造から確定的に判るので修正必須) を、report では validate-report-layout.js (R1-R8 読書レイアウトの実描画契約) を通す。RQ31-34 と D5 で読者価値・専門の深さ・自分ごと化・根拠完全性を確認し、deck-evaluator の mode-aware 30 種思考法 rubric を最大 3 周 reloop。bundle欠落またはCRITICAL残存はhard-fail",
      "gate": "C3",
      "dependsOn": [
        "R2-structure-gate"
      ],
      "entryHook": null,
      "exitHook": "slide:evaluate-deck | report:validate-report-visual",
      "resourceIds": [
        "ref-html-generation-rules",
        "ref-layout-optimization-rules",
        "ref-ui-quality-checklist",
        "ref-report-quality-checklist",
        "ref-deck-evaluation-rubric",
