{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": [
        "artifact_created",
        "minimal_guard_passed",
        "artifact_presented",
        "user_choice_recorded",
        "semantic_evaluator_started",
        "handoff_complete"
      ],
      "transitions": [
        {
          "from": "artifact_created",
          "event": "minimum_guard_pass",
          "to": "minimal_guard_passed"
        },
        {
          "from": "minimal_guard_passed",
          "event": "present_actual_artifact",
          "to": "artifact_presented"
        },
        {
          "from": "artifact_presented",
          "event": "record_user_choice",
          "to": "user_choice_recorded"
        },
        {
          "from": "user_choice_recorded",
          "event": "accept-as-is",
          "to": "handoff_complete"
        },
        {
          "from": "user_choice_recorded",
          "event": "light|standard|detailed",
          "to": "semantic_evaluator_started"
        },
        {
          "from": "semantic_evaluator_started",
          "event": "improvement_complete",
          "to": "handoff_complete"
        }
      ],
      "pre_choice_forbidden": [
        "semantic-evaluator",
        "task-fork",
        "subagent",
        "multi-worker",
        "revise-loop"
      ],
      "accept_contexts": {
        "evaluator": 0,
        "improver": 0
      }
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-briefing",
  "skill": "run-briefing",
  "description": "main context が工程0〜6 を順に進め、確認点ごとに検査済みの現物を見せ、その工程で増えた 決めること を聞き足してから accept-as-is/light/standard/detailed を記録する。独立レビューは light/standard/detailed を選んだ確認点でだけ動く。revise は変更点.md を書き、影響する工程だけを進め直す。",
  "phases": [
    {
      "id": "P0-scaffold",
      "step": 0,
      "title": "出力フォルダと雛形を用意し素材の一覧を見せる",
      "gate": "IN1",
      "dependsOn": [],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": [
        "script-scaffold"
      ],
      "fatal_exit_codes": [
        1,
        2,
        3
      ]
    },
    {
      "id": "P1-hearing",
      "step": 1,
      "title": "ヒアリングを既定案つきで行いヒアリング.md を検査する",
      "gate": "IN1",
      "dependsOn": [
        "P0-scaffold"
