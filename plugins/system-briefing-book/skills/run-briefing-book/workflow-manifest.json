{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": [
        "artifact_created",
        "minimal_guard_passed",
        "artifact_presented",
        "user_choice_recorded",
        "semantic_evaluator_started",
        "handoff_complete"
      ],
      "transitions": [
        {
          "from": "artifact_created",
          "event": "minimum_guard_pass",
          "to": "minimal_guard_passed"
        },
        {
          "from": "minimal_guard_passed",
          "event": "present_actual_artifact",
          "to": "artifact_presented"
        },
        {
          "from": "artifact_presented",
          "event": "record_user_choice",
          "to": "user_choice_recorded"
        },
        {
          "from": "user_choice_recorded",
          "event": "accept-as-is",
          "to": "handoff_complete"
        },
        {
          "from": "user_choice_recorded",
          "event": "light|standard|detailed",
          "to": "semantic_evaluator_started"
        },
        {
          "from": "semantic_evaluator_started",
          "event": "improvement_complete",
          "to": "handoff_complete"
        }
      ],
      "pre_choice_forbidden": [
        "semantic-evaluator",
        "task-fork",
        "subagent",
        "multi-worker",
        "revise-loop"
      ],
      "accept_contexts": {
        "evaluator": 0,
        "improver": 0
      }
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-briefing-book",
  "skill": "run-briefing-book",
  "description": "main context が build-briefing-book.mjs でまとめ HTML を作り、版・古い PNG・外部参照の結果とファイルの場所を報告する。",
  "phases": [
    {
      "id": "K1-build",
      "step": 1,
      "title": "まとめ HTML を作り版と古い PNG と外部参照を検査する",
      "gate": "IN1",
      "dependsOn": [],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": [
        "script-book"
      ],
      "fatal_exit_codes": [
        1,
        2,
        3
      ]
    },
    {
      "id": "K2-report",
      "step": 2,
      "title": "結果とファイルの場所を報告する",
      "gate": "IN2",
      "dependsOn": [
        "K1-build"
      ],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": [],
      "fatal_exit_codes": [
        1,
        2,
        3
      ]
    }
  ],
  "resources": [
    {
      "id": "script-book",
      "kind": "script",
      "path": "../../scripts/build-briefing-book.mjs",
      "phaseIds": [
        "K1-build"
      ]
    }
  ]
}
