{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-system-dev-plan",
  "skill": "run-system-dev-plan",
  "description": "Main contextがactual exact-13 usable draftを生成・deterministic validation・提示してchoiceを記録する。以下のlegacy phases（independent evaluation、atomic promotion、registration）はlight/standard/detailed選択後だけ起動する。",
  "phases": [
    {"id": "R1-preflight-lock", "step": 1, "title": "Resolve caller context, acquire C13 lock, and prove implementation readiness", "gate": "IN1", "dependsOn": [], "entryHook": "PreToolUse:guard-implementation-readiness", "exitHook": null, "resourceIds": ["script-context", "script-lock", "script-readiness"], "fatal_exit_codes": [1, 2]},
    {"id": "R2-emit-handoff", "step": 2, "title": "Elicit and emit the exact-13 package, then commit the C14 handoff", "gate": "IN2", "dependsOn": ["R1-preflight-lock"], "entryHook": null, "exitHook": null, "resourceIds": ["prompt-elicit", "prompt-decompose", "prompt-emit", "script-handoff"], "fatal_exit_codes": [1, 2]},
    {"id": "R3-validate-evaluate", "step": 3, "title": "Run C12 deterministic validation and independent fork evaluation on one digest", "gate": "OUT1", "dependsOn": ["R2-emit-handoff"], "entryHook": null, "exitHook": null, "resourceIds": ["script-validator", "skill-evaluator"], "fatal_exit_codes": [1, 2]},
    {"id": "R4-promote-register", "step": 4, "title": "Validate active owner again, atomically promote, and emit the registration request", "gate": "OUT2", "dependsOn": ["R3-validate-evaluate"], "entryHook": null, "exitHook": null, "resourceIds": ["script-promoter"], "fatal_exit_codes": [1, 2]},
    {"id": "R5-release-report", "step": 5, "title": "Release C13 lock in finalization and project the plan structure report", "gate": "OUT3", "dependsOn": ["R4-promote-register"], "entryHook": null, "exitHook": null, "resourceIds": ["script-lock"], "fatal_exit_codes": [1, 2]}
  ],
  "resources": [
    {"id": "prompt-elicit", "kind": "prompt", "path": "./prompts/R1-elicit.md", "phaseIds": ["R2-emit-handoff"]},
    {"id": "prompt-decompose", "kind": "prompt", "path": "./prompts/R2-decompose.md", "phaseIds": ["R2-emit-handoff"]},
    {"id": "prompt-emit", "kind": "prompt", "path": "./prompts/R3-emit.md", "phaseIds": ["R2-emit-handoff"]},
    {"id": "script-context", "kind": "script", "path": "../../scripts/resolve-project-context.py", "phaseIds": ["R1-preflight-lock"]},
    {"id": "script-lock", "kind": "script", "path": "../../scripts/manage-system-plan-lock.py", "phaseIds": ["R1-preflight-lock", "R5-release-report"]},
    {"id": "script-readiness", "kind": "script", "path": "../../scripts/check-implementation-readiness.py", "phaseIds": ["R1-preflight-lock"]},
    {"id": "script-handoff", "kind": "script", "path": "../../scripts/build-system-handoff.py", "phaseIds": ["R2-emit-handoff"]},
    {"id": "script-validator", "kind": "script", "path": "../../scripts/validate-system-plan.py", "phaseIds": ["R3-validate-evaluate"]},
    {"id": "skill-evaluator", "kind": "skill", "path": "../assign-system-dev-plan-evaluator/SKILL.md", "phaseIds": ["R3-validate-evaluate"]},
    {"id": "script-promoter", "kind": "script", "path": "../../scripts/promote-system-plan.py", "phaseIds": ["R4-promote-register"]}
  ]
}
