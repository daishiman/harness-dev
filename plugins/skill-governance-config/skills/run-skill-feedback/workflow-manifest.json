{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-skill-feedback",
  "skill": "run-skill-feedback",
  "description": "利用者発端の改善要望を Notion 改善要望 DB へ N:1 relation 付きで投入する。",
  "phases": [
    {
      "id": "identify-target",
      "step": 1,
      "title": "目的ヒアリングによる対象スキル同定 (ユーザーはスキル名・プラグイン名を知らない前提)",
      "kind_filter": ["run"],
      "output_artifact": "(in-memory: resolved plugin + skill_name)"
    },
    {
      "id": "read-current-spec",
      "step": 2,
      "title": "確定スキルの SKILL.md を Read し現状仕様をユーザーに提示・文脈確認",
      "dependsOn": ["identify-target"],
      "kind_filter": ["run"],
      "output_artifact": "(in-memory: current spec summary)"
    },
    {
      "id": "collect",
      "step": 3,
      "title": "要望の対話収集 (タイトル/種別/内容/背景/優先度/重要度)",
      "dependsOn": ["read-current-spec"],
      "kind_filter": ["run"],
      "output_artifact": "(in-memory feedback record)"
    },
    {
      "id": "submit",
      "step": 4,
      "title": "scripts/notion-submit-improvement.py で 改善要望 DB に POST。存在確認は本投入内包の fail-closed: find_plugin_page() が未登録プラグインをページ作成前に exit 2 で止める。事前確認ステップは持たない",
      "dependsOn": ["collect"],
      "kind_filter": ["run"],
      "output_artifact": "(stdout: [CREATED] <title> -> <page_id>。URL は印字しない)"
    },
    {
      "id": "notify",
      "step": 5,
      "title": "完了通知 (Notion URL + 人手追加項目案内)",
      "dependsOn": ["submit"],
      "kind_filter": ["run"],
      "output_artifact": "(stdout: page_id から組み立てた Notion URL + 人手追加項目 (起票者/担当者) の案内)"
    }
  ],
  "resources": [
    {"type": "script",    "path": "scripts/notion-submit-improvement.py"},
    {"type": "script",    "path": "plugins/harness-creator/scripts/notion_config.py"},
    {"type": "script",    "path": "scripts/lint-feedback-protocol.py"},
    {"type": "schema",    "path": "doc/notion-schema/improvement-request.schema.json"},
    {"type": "schema",    "path": "doc/notion-schema/skill-list.schema.json"},
    {"type": "reference", "path": "plugins/harness-creator/skills/run-build-skill/references/goal-seek-paradigm.md"},
    {"type": "reference", "path": "plugins/harness-creator/skills/run-skill-feedback/references/notion-submit-contract.md"}
  ]
}
