{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "fingerprint",
    "reviewPolicyFingerprint",
    "reviewer",
    "reviewedAt",
    "mode",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewPolicyFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "independent-agents",
        "independent-reviewer-lenses",
        "self-review"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pngSha256",
          "variantFingerprint",
          "viewedFull",
          "viewedThumbnail",
          "viewedDetails",
          "readingTest",
          "privacyChecked",
          "axisChecked",
          "worldviewChecked",
          "observations",
          "criteria",
          "expertReviews",
          "mandatoryFixes",
          "preferenceNotes",
          "decision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pngSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "variantFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "$comment": "project.cjs の fingerprint(project, id)。この案の入力と共通部分の指紋。"
          },
          "reusedFrom": {
            "type": "object",
            "required": [
              "file",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "$comment": "入力・画像・品質基準が同じ案の以前の独立 PASS を、そのまま引き継いだときの元ファイル（project 相対）と SHA。"
          },
          "viewedFull": {
            "type": "boolean"
          },
          "viewedThumbnail": {
            "type": "boolean"
          },
          "viewedDetails": {
            "type": "boolean"
          },
          "readingTest": {
            "type": "object",
            "required": [
              "firstRead",
              "firstGroup",
              "nextRead",
              "nextGroup",
              "hesitation",
              "audienceCue"
            ],
            "additionalProperties": false,
            "properties": {
              "firstRead": {
                "type": "string",
                "pattern": "\\S"
              },
              "firstGroup": {
                "type": "string",
                "minLength": 1
              },
              "nextRead": {
                "type": "string",
                "pattern": "\\S"
              },
              "nextGroup": {
                "type": "string",
                "minLength": 1
              },
              "hesitation": {
                "type": "string"
              },
              "audienceCue": {
                "type": "string",
                "minLength": 12,
                "pattern": "\\S"
              }
            }
          },
          "privacyChecked": {
            "type": "boolean"
          },
          "axisChecked": {
            "type": "boolean"
          },
          "worldviewChecked": {
            "type": "boolean"
          },
          "observations": {
            "type": "string",
            "minLength": 12,
            "pattern": "\\S"
          },
          "criteria": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "verdict",
                "region",
                "observation",
                "intentRef",
                "confidence"
              ],
              "additionalProperties": false,
              "properties": {
                "verdict": {
                  "enum": [
                    "pending",
                    "PASS",
                    "FIX"
                  ]
                },
                "region": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "observation": {
                  "type": "string",
                  "minLength": 12,
                  "pattern": "\\S"
                },
                "intentRef": {
                  "type": "string",
                  "pattern": "^/"
                },
                "confidence": {
                  "enum": [
                    "high",
                    "low"
                  ],
                  "$comment": "low は design-contract.json の expertEscalation に当たり、その観点の専門レンズを必須にする。"
                }
              }
            }
          },
          "expertReviews": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "reviewer",
                "verdict",
                "criteria"
              ],
              "additionalProperties": false,
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "verdict": {
                  "enum": [
                    "pending",
                    "PASS",
                    "FIX"
                  ]
                },
                "criteria": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "mandatoryFixes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "fixClass",
                "serves",
                "returnTo"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "fixClass": {
                  "enum": [
                    "deterministic",
                    "within-plan",
                    "premise"
                  ]
                },
                "serves": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^E[0-9]+$"
                  }
                },
                "returnTo": {
                  "enum": [
                    "run-create-flyer",
                    "run-analyze-flyer",
                    "run-intake-flyer"
                  ]
                }
              }
            },
            "$comment": "分類と戻り先の正本は references/workflow.md の表。serves は essence.json の clauses の ID。好み（preference）は入れず preferenceNotes へ。"
          },
          "preferenceNotes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "category": {
                  "type": "string",
                  "minLength": 1,
                  "$comment": "design-contract.json の qualityDimensions のどれか（design.cjs が検査）。"
                }
              }
            },
            "$comment": "本質条項に結べない好み。記録だけで、合否と改善 cycle に使わない（R1）。"
          },
          "decision": {
            "enum": [
              "pending",
              "PASS",
              "FIX"
            ]
          },
          "feedbackChecks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "feedbackId",
                "verdict",
                "criteria"
              ],
              "additionalProperties": false,
              "properties": {
                "feedbackId": {
                  "type": "string",
                  "minLength": 1
                },
                "verdict": {
                  "enum": [
                    "pending",
                    "PASS",
                    "FIX"
                  ]
                },
                "criteria": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "preservationChecks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "strength",
                "verdict",
                "observation"
              ],
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "type": "string",
                  "minLength": 1
                },
                "verdict": {
                  "enum": [
                    "pending",
                    "PASS",
                    "FIX"
                  ]
                },
                "observation": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
