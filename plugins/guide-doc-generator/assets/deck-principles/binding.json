{
  "$schema": "deck-principles-binding.schema.json",
  "_meta": {
    "role": "guide-doc-generator の consumer だけを持つ plugin-local overlay。原則本文と selector は上流 vendor manifest の generated byte mirror",
    "standalone": "実行時に sibling plugin を読まず、同梱 principles.json と本 binding だけで consumer を解決する"
  },
  "schema_version": 1,
  "consumer_scope": {
    "owner_skills": ["run-handout-build", "assign-handout-readability-evaluator"],
    "excluded_agents": []
  },
  "consumers": [
    {
      "id": "handout-content-architect",
      "plugin": "guide-doc-generator",
      "prompt": "skills/run-handout-build/prompts/R2a-design-config.md",
      "when": "handout-config.json のセクション構成と部品選択を決める前",
      "select": [
        "--applies-to",
        "doc",
        "--phase",
        "story",
        "--phase",
        "write",
        "--limit",
        "14"
      ],
      "intent": "手順書でも背景・課題・解決策・効果の骨格を持たせ、lead-line を各節の主張文として立てる",
      "core_refs": [
        "DP-030",
        "DP-032",
        "DP-033",
        "DP-034",
        "DP-076",
        "DP-079",
        "DP-081",
        "DP-082",
        "DP-089"
      ],
      "existing_receiver": "skills/ref-handout-design-system/SKILL.md 面4「文章設計の型」",
      "vendored_catalog": "assets/deck-principles/principles.json (generated byte mirror)",
      "run_by": "orchestrator"
    },
    {
      "id": "handout-readability-reviewer",
      "plugin": "guide-doc-generator",
      "prompt": "skills/assign-handout-readability-evaluator/prompts/R1-review-readability.md",
      "when": "初心者に伝わるかの判定時",
      "select": [
        "--applies-to",
        "doc",
        "--phase",
        "write",
        "--phase",
        "review",
        "--limit",
        "12"
      ],
      "intent": "専門用語の残存・抽象と具体の往復の欠落を、原則の言葉で指摘できるようにする",
      "core_refs": [
        "DP-010",
        "DP-078",
        "DP-082",
        "DP-089"
      ],
      "existing_receiver": "scripts/verify-handout-language.py / verify-handout-narrative.py",
      "vendored_catalog": "assets/deck-principles/principles.json (generated byte mirror)",
      "run_by": "agent"
    }
  ],
  "mapped_by_filter": {
    "_note": "guide consumer の raw filter 到達集合。already_enforced / out_of_scope と排他的",
