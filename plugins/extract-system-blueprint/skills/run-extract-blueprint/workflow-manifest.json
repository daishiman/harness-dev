{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-extract-blueprint",
  "skill": "run-extract-blueprint",
  "description": "Main contextが認可済み最小snapshotからactual blueprint draftを作成・guard・提示する。独立分析・Mermaid拡充・評価のlegacy phasesはlight/standard/detailed選択後だけ起動する。",
  "phases": [
    {
      "id": "R1-fetch",
      "step": 1,
      "title": "認可preflightと低負荷取得",
      "gate": "IN1",
      "dependsOn": [],
      "entryHook": "PreToolUse:C08",
      "exitHook": null,
      "resourceIds": ["prompt-r1", "script-authz", "script-fetch"],
      "fatal_exit_codes": [1, 2]
    },
    {
      "id": "R2-analyze",
      "step": 2,
      "title": "fact抽出とinference分析の独立fan-out/fan-in",
      "gate": "OUT1",
      "dependsOn": ["R1-fetch"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": ["prompt-r2"],
      "fatal_exit_codes": [2]
    },
    {
      "id": "R3-document",
      "step": 3,
      "title": "blueprint文書化と決定論検証",
      "gate": "IN1",
      "dependsOn": ["R2-analyze"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": ["prompt-r3", "script-doc", "script-mermaid", "schema-blueprint"],
      "fatal_exit_codes": [1, 2]
    }
  ],
  "resources": [
    {"id": "prompt-r1", "kind": "prompt", "path": "./prompts/R1-fetch.md", "phaseIds": ["R1-fetch"]},
    {"id": "prompt-r2", "kind": "prompt", "path": "./prompts/R2-analyze.md", "phaseIds": ["R2-analyze"]},
    {"id": "prompt-r3", "kind": "prompt", "path": "./prompts/R3-document.md", "phaseIds": ["R3-document"]},
    {"id": "script-authz", "kind": "script", "path": "../../scripts/authz-classify.py", "phaseIds": ["R1-fetch"]},
    {"id": "script-fetch", "kind": "script", "path": "../../scripts/fetch-snapshot.py", "phaseIds": ["R1-fetch"]},
    {"id": "script-doc", "kind": "script", "path": "../../scripts/doc-emit.py", "phaseIds": ["R3-document"]},
    {"id": "script-mermaid", "kind": "script", "path": "../../scripts/mermaid-validate.py", "phaseIds": ["R3-document"]},
    {"id": "schema-blueprint", "kind": "schema", "path": "../../schemas/system-blueprint.schema.json", "phaseIds": ["R3-document"]}
  ]
}
