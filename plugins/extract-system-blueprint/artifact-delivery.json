    "confirmation_event": "UserPromptSubmit",
    "enforcement_event": "PreToolUse",
    "enforcement_scope": "recognized-bash-remote-mutations-and-all-bash-during-pending-guard-context",
    "flow": "preview-confirm-authorize-execute-v1",
    "runner_sha256": "cda109eeacf40063ea908107e29e1fae7c56aed4a0ad6a6645146f928ccd2b8e",
    "schema_sha256": "32938bf5793b0c564bcd1ea2cf829cabdde3973e29512cae5fe0fe647195258a",
