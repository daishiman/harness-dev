  "auto_promotion": {
    "exhaustive": false,
    "release": false
  },
  "minimum_safe_guard": {
    "fail_closed_on_unknown_effect": true,
    "target_scope_required": true
  },
  "entrypoints": [
    {
      "path": "skills/assign-blueprint-fidelity-evaluator/SKILL.md",
      "effect": "conversation-output",
      "guard": "no-target-mutation"
    },
    {
      "path": "skills/run-blueprint-apply/SKILL.md",
      "effect": "local-artifact",
      "guard": "declared-target-scope-only"
    },
    {
      "path": "skills/run-extract-blueprint/SKILL.md",
      "effect": "external-mutation",
      "guard": "preview-and-explicit-confirmation",
      "guard_contract": {
        "runtime_ref": "#/external_mutation_runtime",
        "flow": "preview-confirm-authorize-execute-v1"
      }
    },
    {
      "path": "skills/run-skill-feedback/SKILL.md",
      "effect": "external-mutation",
      "guard": "preview-and-explicit-confirmation",
      "guard_contract": {
        "runtime_ref": "#/external_mutation_runtime",
        "flow": "preview-confirm-authorize-execute-v1"
      }
    }
  ],
  "external_mutation_runtime": {
    "contract_id": "external-mutation-guard-v1",
