  "qa_log": [
    {
      "id": "qa-000",
      "question": "対象プラットフォームはどれですか?",
      "answer": "本システムは社内向け Web アプリのみ。モバイル/タブレット/デスクトップは全カテゴリで対象外。",
      "basis": "user-decision",
      "required_info_items": [
        "target-platforms"
      ]
    },
    {
      "id": "qa-001",
      "question": "データベース（database）× Web の要件は?",
      "answer": "PostgreSQL 15。ユーザー/請求/監査ログの3スキーマ。日次バックアップ。",
      "basis": "user-decision",
      "required_info_items": [
        "data-persistence",
        "domain-model"
      ]
    },
    {
      "id": "qa-002",
      "question": "認証(ログイン)（auth）× Web の要件は?",
      "answer": "OIDC(社内 IdP)+ ロールベース認可。セッションは 8h。",
      "basis": "user-decision",
      "required_info_items": [
        "auth-model"
      ]
    },
    {
      "id": "qa-003",
      "question": "UI-UX（ui-ux）× Web の要件は?",
      "answer": "レスポンシブ Web。WCAG 2.1 AA 目標。主要動線は3クリック以内。",
      "basis": "user-decision",
      "required_info_items": [
        "information-priority"
      ]
    },
    {
      "id": "qa-004",
      "question": "セキュリティ（security）× Web の要件は?",
      "answer": "TLS1.3・入力検証・監査ログ・OWASP Top10 受動対策。",
      "basis": "user-decision",
      "required_info_items": [
        "security-posture"
      ]
    },
    {
      "id": "qa-005",
      "question": "インフラ（infrastructure）× Web の要件は?",
      "answer": "コンテナを社内 k8s にデプロイ。CI/CD は GitHub Actions。",
      "basis": "user-decision",
      "required_info_items": [
        "infra-topology"
      ]
    },
    {
      "id": "qa-006",
      "question": "バックエンド（backend）× Web の要件は?",
      "answer": "Python/FastAPI。REST + 非同期ジョブ(キュー)。",
      "basis": "user-decision",
      "required_info_items": [
        "api-contract"
      ]
    },
    {
      "id": "qa-007",
      "question": "フロントエンド（frontend）× Web の要件は?",
      "answer": "React + TypeScript。状態管理は最小限のグローバルストア。",
      "basis": "user-decision",
      "required_info_items": [
        "frontend-arch"
      ]
    },
    {
      "id": "qa-008",
      "question": "保守運用管理（maintenance-ops）× Web の要件は?",
      "answer": "オンコール輪番・障害 runbook・週次リストア訓練。",
      "basis": "user-decision",
      "required_info_items": [
        "ops-runbook"
      ]
    },
    {
      "id": "qa-009",
      "question": "この Web アプリが解決する主要な利用者課題 (JTBD)・対象ユーザーと、利用される文脈 (場所/端末/頻度/制約) は?",
      "answer": "対象は社内の請求業務担当 40 名。月次請求の突合を表計算の手作業から移し、締め日前の残業を無くすことが主要課題。利用文脈は社内ネットワーク上のデスクトップブラウザが中心で、月末3営業日に利用が集中する。",
      "basis": "user-decision",
      "required_info_items": [
        "context-of-use",
        "product-goal"
      ]
    }
  ],
