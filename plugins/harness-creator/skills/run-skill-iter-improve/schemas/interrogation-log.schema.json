{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "interrogation-log",
  "description": "run-skill-iter-improve の毎 iter PASS 詐欺自己審問ログ (design-decisions D11)。1 iter = 1 object を eval-log/<plugin>/<skill>/iter-improve/<run-id>/interrogation-log.jsonl へ append-only で保存する必須 artifact。緩め禁止リストの target 固有正本は goal-spec.json.forbidden_loosening、一般形は run-elegant-review/references/convergence-policy.json の anti_patterns。独立判定の発火条件 (score 急変 / 評価経路接触) は本 schema の allOf が機械正本。",
  "type": "object",
  "required": [
    "iter",
    "proposed_changes",
    "self_interrogation",
    "forbidden_loosening_check",
    "score_delta",
    "independent_check",
    "discarded"
  ],
  "additionalProperties": false,
  "properties": {
    "iter": {
      "type": "integer",
      "minimum": 1,
      "description": "周回番号。GOAL DECLARATION (iter 0) は goal-spec 側に記録するため本ログは 1 始まり。"
    },
    "proposed_changes": {
      "type": "array",
      "minItems": 1,
      "description": "この iter で投入予定の改善案 (edit 実行前に記録)。件数上限は convergence-policy loop_bounds.iter_improve.batch_per_iter_max (INVARIANT 5)。",
      "items": {
        "type": "object",
        "required": ["path", "summary", "touches_evaluation_path"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "編集対象ファイル (repo 相対パス)。"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "改善内容の 1 行要約。"
          },
          "touches_evaluation_path": {
            "type": "boolean",
            "description": "評価経路 (evaluator / rubric / 採点 mode / 閾値 / 採点対象 / 評価手順 / 収束条件 / 集計ロジック) に触れる変更か。true なら自己申告の有無に関わらず independent_check.required=true (客観条件、下記 allOf で機械強制)。"
          }
        }
      }
    },
    "self_interrogation": {
      "type": "object",
      "required": ["is_generator_improvement", "rationale"],
      "additionalProperties": false,
      "properties": {
        "is_generator_improvement": {
          "type": "boolean",
          "description": "generator (成果物を作る側) を良くする改善か (INVARIANT 1 自己審問)。false = evaluator 緩和系であり破棄対象。"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Yes/No の 1 行根拠。"
        }
      }
    },
    "forbidden_loosening_check": {
      "type": "object",
      "required": ["violated", "matched_rule"],
      "additionalProperties": false,
      "properties": {
        "violated": {
          "type": "boolean",
          "description": "iter 0 で宣言した緩め禁止リスト (goal-spec.forbidden_loosening + convergence-policy anti_patterns) に抵触するか。"
        },
        "matched_rule": {
          "type": ["string", "null"],
          "description": "抵触時に一致した規則文。非抵触なら null。"
        }
      }
    },
    "score_delta": {
      "type": "number",
      "description": "前 iter の score との avg overall score 差分。iter 1 はこの run の中に比べる前の状態が無いので 0。前 iter の commit が revert だけのときは、target が前々 iter の採点した状態に戻っているので前々 iter の score と比べる (revert は前 iter の commit を全部戻し、1 本だけ戻すことはしないので、比べる相手はいつも 1 つに決まる)。急変時は independent_check.required=true (allOf で機械強制)。急変で判定させるのは急変を起こした前 iter の commit で、今回の edit ではない (前 iter が commit しなかったか revert だけなら今回の edit。SKILL.md 局面「独立判定と審問ログの確定」)。"
    },
    "independent_check": {
      "type": "object",
      "required": ["required", "verdict", "agent_independent"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean",
          "description": "別個体 fresh agent の独立判定が必要か。score 急変 / 評価経路接触で true 必須。"
        },
        "verdict": {
          "enum": ["generator", "loosening", null],
          "description": "独立判定の結論で、judgments の集約。generator=真の generator 改善 / loosening=評価を緩める操作 (破棄必須)。judgments のどれかが loosening なら loosening、全部 generator なら generator (allOf)。未実施 (required=false) は null。required=true なら非 null 必須 (allOf)。"
        },
        "agent_independent": {
          "type": "boolean",
          "description": "判定 agent が GOAL VERIFICATION agent と別個体・履歴非共有か (D11 判定者独立性)。verdict 非 null なら true 必須 (allOf)。"
        },
        "judgments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "独立判定 agent に判定させた diff ごとの結論 (SKILL.md 局面「独立判定と審問ログの確定」)。current_edit = この iter の edit の diff (commit 前なので commit_sha は null)、prior_commit = 前 iter の commit の diff (git diff <commit_sha>~1 <commit_sha>。sha は前 iter の commit item が intermediate.jsonl の commits に記録したもの)。verdict が非 null の行では必須: 判定した diff が書かれていない verdict は、どの変更を緩めと判定したか、どの commit を戻したかを残せないため。verdict が null の行には書かない (この field を足す前の形の行も、verdict が null ならそのまま通る)。prior_commit が 1 つでも loosening なら、ここに並ぶ prior_commit の commit を全部 revert したと読む (1 本だけ戻すことはしない)。戻したことは前 iter の行を書き換えずにこの行に残す。",
          "items": {
            "type": "object",
            "required": ["subject", "commit_sha", "verdict"],
            "additionalProperties": false,
            "properties": {
              "subject": {
                "enum": ["current_edit", "prior_commit"],
                "description": "判定させた diff の出どころ。current_edit=この iter の edit / prior_commit=前 iter の commit。"
              },
              "commit_sha": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{7,40}$",
                "description": "prior_commit なら判定させた commit の sha (wrap-git-commit-safe の commit_sha)。current_edit は commit 前なので null。"
              },
              "verdict": {
                "enum": ["generator", "loosening"],
                "description": "この diff の判定。"
              }
            },
            "allOf": [
              {
                "$comment": "前 iter の commit の判定は、どの commit を判定したかを sha で残す",
                "if": {
                  "properties": { "subject": { "const": "prior_commit" } },
                  "required": ["subject"]
                },
                "then": {
                  "properties": { "commit_sha": { "type": "string" } }
                }
              },
              {
                "$comment": "今回の edit は commit 前なので sha を持たない",
                "if": {
                  "properties": { "subject": { "const": "current_edit" } },
                  "required": ["subject"]
                },
                "then": {
                  "properties": { "commit_sha": { "type": "null" } }
                }
              }
            ]
          }
        }
      }
    },
    "discarded": {
      "type": "boolean",
      "description": "この iter の改善案 (proposed_changes) を破棄したか。緩め禁止抵触 / 独立判定 loosening なら true 必須 (allOf)。前 iter の commit を戻したかは independent_check.judgments で読む。"
    }
  },
  "allOf": [
    {
      "$comment": "score 急上昇 (+10pt 超) は独立判定必須 (convergence-policy anti_patterns / D11)",
      "if": {
        "properties": { "score_delta": { "exclusiveMinimum": 10 } },
        "required": ["score_delta"]
      },
      "then": {
        "properties": {
          "independent_check": {
            "properties": { "required": { "const": true } }
          }
        }
      }
    },
    {
      "$comment": "score 急降下 (-10pt 超) も同様 (|score_delta|>10 で対称)",
      "if": {
        "properties": { "score_delta": { "exclusiveMaximum": -10 } },
        "required": ["score_delta"]
      },
      "then": {
        "properties": {
          "independent_check": {
            "properties": { "required": { "const": true } }
          }
        }
      }
    },
    {
      "$comment": "評価経路接触は score 急変の有無・自己申告の有無に関わらず独立判定必須 (客観条件を最後の砦にする)",
      "if": {
        "properties": {
          "proposed_changes": {
            "contains": {
              "properties": { "touches_evaluation_path": { "const": true } },
              "required": ["touches_evaluation_path"]
            }
          }
        },
        "required": ["proposed_changes"]
      },
      "then": {
        "properties": {
          "independent_check": {
            "properties": { "required": { "const": true } }
          }
        }
      }
    },
    {
      "$comment": "required=true の iter は verdict 非 null (独立判定実施済) が必須",
      "if": {
        "properties": {
          "independent_check": {
            "properties": { "required": { "const": true } },
            "required": ["required"]
          }
        },
        "required": ["independent_check"]
      },
      "then": {
        "properties": {
          "independent_check": {
            "properties": { "verdict": { "type": "string" } }
          }
        }
      }
    },
    {
      "$comment": "verdict を出した独立判定は別個体性 (agent_independent=true) が必須",
      "if": {
        "properties": {
          "independent_check": {
            "properties": { "verdict": { "type": "string" } },
            "required": ["verdict"]
          }
        },
        "required": ["independent_check"]
      },
      "then": {
        "properties": {
          "independent_check": {
            "properties": { "agent_independent": { "const": true } }
          }
        }
      }
    },
    {
      "$comment": "緩め禁止抵触は破棄必須 (INVARIANT 1)",
      "if": {
        "properties": {
          "forbidden_loosening_check": {
            "properties": { "violated": { "const": true } },
            "required": ["violated"]
          }
        },
        "required": ["forbidden_loosening_check"]
      },
      "then": {
        "properties": { "discarded": { "const": true } }
      }
    },
    {
      "$comment": "独立判定 loosening は自己審問より外部判定を優先し破棄必須 (INVARIANT 8)",
      "if": {
        "properties": {
          "independent_check": {
            "properties": { "verdict": { "const": "loosening" } },
            "required": ["verdict"]
          }
        },
        "required": ["independent_check"]
      },
      "then": {
        "properties": { "discarded": { "const": true } }
      }
    },
    {
      "$comment": "verdict を出した独立判定は、判定した diff ごとの結論 (judgments) が必須",
      "if": {
        "properties": {
          "independent_check": {
            "properties": { "verdict": { "type": "string" } },
            "required": ["verdict"]
          }
        },
        "required": ["independent_check"]
      },
      "then": {
        "properties": {
          "independent_check": { "required": ["judgments"] }
        }
      }
    },
    {
      "$comment": "独立判定を行っていない (verdict=null) 行は judgments を持たない",
      "if": {
        "properties": {
          "independent_check": {
            "properties": { "verdict": { "type": "null" } },
            "required": ["verdict"]
          }
        },
        "required": ["independent_check"]
      },
      "then": {
        "properties": {
          "independent_check": { "not": { "required": ["judgments"] } }
        }
      }
    },
    {
      "$comment": "judgments に loosening が 1 つでもあれば verdict は loosening (集約が食い違わない)",
      "if": {
        "properties": {
          "independent_check": {
            "properties": {
              "judgments": {
                "contains": {
                  "properties": { "verdict": { "const": "loosening" } },
                  "required": ["verdict"]
                }
              }
            },
            "required": ["judgments"]
          }
        },
        "required": ["independent_check"]
      },
      "then": {
        "properties": {
          "independent_check": {
            "properties": { "verdict": { "const": "loosening" } }
          }
        }
      }
    },
    {
      "$comment": "verdict が loosening なら judgments のどれかが loosening (判定の根拠が無い loosening を許さない)",
      "if": {
        "properties": {
          "independent_check": {
            "properties": { "verdict": { "const": "loosening" } },
            "required": ["verdict"]
          }
        },
        "required": ["independent_check"]
      },
      "then": {
        "properties": {
          "independent_check": {
            "properties": {
              "judgments": {
                "contains": {
                  "properties": { "verdict": { "const": "loosening" } },
                  "required": ["verdict"]
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "評価経路接触の iter は、今回の edit の diff を判定した結論 (subject=current_edit) が必須",
      "if": {
        "properties": {
          "proposed_changes": {
            "contains": {
              "properties": { "touches_evaluation_path": { "const": true } },
              "required": ["touches_evaluation_path"]
            }
          }
        },
        "required": ["proposed_changes"]
      },
      "then": {
        "properties": {
          "independent_check": {
            "properties": {
              "judgments": {
                "contains": {
                  "properties": { "subject": { "const": "current_edit" } },
                  "required": ["subject"]
                }
              }
            }
          }
        }
      }
    }
  ]
}
