{
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "workflowId": "run-skill-create",
  "skill": "run-skill-create",
  "description": "run-skill-create の Step/Gate を機械可読化したフロー定義。SKILL.md は本 manifest と prompts/*.md を参照する。",
  "max_iterations": 3,
  "gate_order": ["G1", "G2.5", "G2"],
  "gate_order_comment": "Gate 通過順序の正本 (phases[].gate の非 null 値を実工程順 = step 1→3→4a に並べたもの)。SKILL.md は本配列を参照し Gate 番号順を直書きしない。",
  "evaluation_source": {
    "c1_c4": "run-build-skill の初稿診断 receipt (initial-draft-review の review.json と、改善した場合の improvement-validation.json) を正本とし、本 workflow は receipt を読んで完了レポートへ転記するだけで評価し直さない。receipt が無い (accept-as-is) 場合は未診断として報告する。",
    "governance": "rubric を変更するときだけ利用者が run-skill-rubric-governance を明示的に呼ぶ。本 workflow の既定の流れには含めない。"
  },
  "phases": [
    {
      "id": "elicit",
      "step": 1,
      "gate": 1,
      "title": "要求ヒアリング",
      "dependsOn": [],
      "entryHook": null,
      "exitHook": "validate-brief-or-intake-publish-ready",
      "resourceIds": [
        "schemas/skill-brief.schema.json",
        "prompts/R1-elicit.md",
        "prompts/R2-gate-review.md",
        "scripts/validate-intake-publish-ready.py"
      ],
      "delegateSkill": "run-skill-elicit",
      "fatal_exit_codes": [2],
      "handoff": "eval-log/handoff-after_elicit.json",
      "transition": {"gate": "brief schema PASSかつGate 1の明示decisionがPASS", "on_pass": "build", "on_fail": "abort"}
    },
    {
      "id": "build",
      "step": 2,
      "gate": null,
      "title": "スキル生成",
      "dependsOn": ["elicit"],
      "entryHook": "load-brief",
      "exitHook": "emit-build-trace",
      "resourceIds": [
        "schemas/skill-brief.schema.json",
        "../run-build-skill/schemas/skill-build-trace.schema.json"
      ],
      "delegateSkill": "run-build-skill",
      "fatal_exit_codes": [1, 2],
      "handoff": "eval-log/handoff-after_build.json",
      "transition": {"gate": "build traceがschema準拠かつfatal exitなし", "on_pass": "manifest-register", "on_fail": "abort"}
    },
    {
      "id": "manifest-register",
      "step": 3,
      "gate": 2.5,
      "title": "plugin/marketplace 登録判定",
      "dependsOn": ["build"],
      "entryHook": null,
      "exitHook": "lint-manifest-contents",
      "resourceIds": [
        "prompts/R2-gate-review.md"
      ],
      "delegateSkill": null,
      "command": "SIBLING_PLUGIN_ROOT=\"$(python3 \"$PLUGIN_ROOT/scripts/extract-plugin-root.py\" skill-governance-automation)\" && python3 \"$SIBLING_PLUGIN_ROOT/scripts/build-manifest-registration-plan.py\"",
      "fatal_exit_codes": [1, 2],
      "transition": {"gate": "登録plan検証PASSかつGate 2.5の明示decisionがPASS", "on_pass": "bundle-register", "on_fail": "abort"}
    },
    {
      "id": "bundle-register",
      "step": 3.5,
      "gate": null,
      "title": "marketplace + bundle 登録判定",
      "dependsOn": ["manifest-register"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": [],
      "delegateSkill": null,
      "command": "python3 scripts/validate-plugin-completeness.py --fix",
      "artifact": [".claude-plugin/marketplace.json", ".claude-plugin/bundles.json"],
      "comment": "新規 plugin を実体ディレクトリ起点で marketplace.json + bundles.json へ append-only 自動登録し書込後自己再検証。既登録は no-op。最終承認は人間が PR diff で。検出層 (validate-plugin-completeness.py 引数なし) が CI/pre-push の最後の砦。",
      "fatal_exit_codes": [1],
      "transition": {"gate": "marketplaceとbundleの登録検証がPASS", "on_pass": "codex-platform-sync", "on_fail": "abort"}
    },
    {
      "id": "codex-platform-sync",
      "step": 3.55,
      "gate": null,
      "title": "Codex plugin manifest + marketplace 同期",
      "dependsOn": ["bundle-register"],
      "entryHook": null,
      "exitHook": null,
      "condition": "plugin_manifest.exists == true",
      "resourceIds": ["../run-codex-plugin-package/SKILL.md"],
      "delegateSkill": "run-codex-plugin-package",
      "command": "python3 ${PLUGIN_ROOT}/scripts/sync-plugin-platforms.py --repo-root . --plugin plugins/<plugin> --apply",
      "artifact": ["plugins/<plugin>/.codex-plugin/plugin.json", ".agents/plugins/marketplace.json"],
      "comment": "Claude plugin envelope を正本に Codex manifest と official repo marketplace entry を決定論生成する。--check 再実行で drift 0 を要求。",
      "fatal_exit_codes": [1, 3],
      "transition": {"gate": "plugin manifest非該当またはCodex projection apply成功", "on_pass": "codex-platform-check", "on_fail": "abort"}
    },
    {
      "id": "codex-platform-check",
      "step": 3.56,
      "gate": null,
      "title": "Codex plugin projection 再検査",
      "dependsOn": ["codex-platform-sync"],
      "entryHook": null,
      "exitHook": null,
      "condition": "plugin_manifest.exists == true",
      "resourceIds": ["../run-codex-plugin-package/SKILL.md"],
      "delegateSkill": "run-codex-plugin-package",
      "command": "python3 ${PLUGIN_ROOT}/scripts/sync-plugin-platforms.py --repo-root . --plugin plugins/<plugin> --check",
      "artifact": ["plugins/<plugin>/.codex-plugin/plugin.json", ".agents/plugins/marketplace.json"],
      "comment": "applyと独立したcheckを機械実行し、生成直後のdriftをfail-closedで拒否する。create/updateは同一upsert。",
      "fatal_exit_codes": [1, 3],
      "transition": {"gate": "plugin manifest非該当またはCodex projection checkがexit 0", "on_pass": "local-marketplace-register", "on_fail": "abort"}
    },
    {
      "id": "local-marketplace-register",
      "step": 3.6,
      "gate": null,
      "title": "ローカル clone marketplace 再生成",
      "dependsOn": ["codex-platform-check"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": [],
      "delegateSkill": null,
      "command": "python3 scripts/build-local-marketplace.py",
      "artifact": ["marketplaces/local/.claude-plugin/marketplace.json"],
      "comment": "公開 marketplace は distributable:false を載せられない (MK-004 逆ガード + NEVER_DISTRIBUTE denylist) ため、非配布 plugin は手元でも install できない。ローカル clone 用 marketplace を再生成して新 plugin を載せる。検出層は build-local-marketplace.py --check (CI)。",
      "fatal_exit_codes": [1],
      "transition": {"gate": "local marketplace再生成と自己検証がPASS", "on_pass": "plugin-release-record", "on_fail": "abort"}
    },
    {
      "id": "plugin-release-record",
      "step": 3.7,
      "gate": null,
      "title": "plugin fingerprint 記録 / version 採番",
      "dependsOn": ["local-marketplace-register"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": [],
      "delegateSkill": null,
      "command": "python3 scripts/build-plugin-release.py --only <plugin>",
      "artifact": ["marketplaces/local/plugin-fingerprints.json"],
      "comment": "marketplace install は version 単位の copy であり、version を据え置くと install 済み copy へ変更が届かない。新 plugin を内容 hash 対応表へ記録し、既存 plugin の内容変更には patch を採番する。検出層は build-plugin-release.py --check (CI)。install 済み copy への反映は --install。書き込みを伴う実行は Gate 2.5 承認後に限り、--only <plugin> を必須とする (SKILL.md Key Rule 6): write_version() は既存 version 行の in-place 置換で append-only ではなく、--only 無指定は _run() の only=None により全 plugin 走査となって無関係な変更済み plugin まで patch bump するため。",
      "fatal_exit_codes": [1],
      "transition": {"gate": "Gate 2.5承認済みかつ--only対象のrelease記録が検証済み", "on_pass": "p0-lint", "on_fail": "abort"}
    },
    {
      "id": "p0-lint",
      "step": "4a",
      "gate": 2,
      "title": "P0 lint (create 固有分のみ。build Step 4 と重複する lint は build の結果を再利用)",
      "dependsOn": ["plugin-release-record"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": [],
      "delegateSkill": null,
      "build_lint_reuse": {
        "receipt": "eval-log/skill-build-trace.json#/reproducibility_gates/lint",
        "required_status": "PASS",
        "required_match": {"skill_name": "brief.skill_name"},
        "covered_scripts": ["lint-skill-name.py", "lint-skill-description.py", "lint-skill-tree.py", "validate-frontmatter.py", "validate-build-plan.py"],
        "on_missing_or_fail": "build",
        "comment": "covered_scripts は run-build-skill Step 4 (lint-matrix の build-preflight) が同じ生成物に対して実行済みなので、ここでは再実行しない。receipt が無い、receipt の skill_name が今回の brief.skill_name と違う (別 skill の trace が残っている)、または lint が PASS でなければ commands を走らせずに build へ戻す。skills ディレクトリ全体への横断検査は CI (lint-matrix の ci) が受け持つ。"
      },
      "commands": [
        "SIBLING_PLUGIN_ROOT=\"$(python3 \"$PLUGIN_ROOT/scripts/extract-plugin-root.py\" skill-governance-lint)\" && python3 \"$SIBLING_PLUGIN_ROOT/scripts/lint-dependency-direction.py\" --skills-dir \"${SKILLS_DIR}\"",
        "SIBLING_PLUGIN_ROOT=\"$(python3 \"$PLUGIN_ROOT/scripts/extract-plugin-root.py\" skill-governance-lint)\" && python3 \"$SIBLING_PLUGIN_ROOT/scripts/lint-skill-dep-step7.py\" --skills-dir \"${SKILLS_DIR}\"",
        "SIBLING_PLUGIN_ROOT=\"$(python3 \"$PLUGIN_ROOT/scripts/extract-plugin-root.py\" skill-governance-lint)\" && python3 \"$SIBLING_PLUGIN_ROOT/scripts/lint-forbidden-deps.py\" --skills-dir \"${SKILLS_DIR}\"",
        "SIBLING_PLUGIN_ROOT=\"$(python3 \"$PLUGIN_ROOT/scripts/extract-plugin-root.py\" skill-governance-lint)\" && python3 \"$SIBLING_PLUGIN_ROOT/scripts/lint-manifest-contents.py\"",
        "python3 ${PLUGIN_ROOT}/scripts/audit-capability-parity.py --repo-root . --plugin plugins/<plugin> --json"
      ],
      "max_retry": 3,
      "fatal_exit_codes": [1, 2],
      "handoff": "eval-log/handoff-after_lint.json",
      "transition": {"gate": "build lint receiptがPASSかつcreate固有のP0 lintがexit 0かつGate 2の明示decisionがPASS", "on_pass": "pkg-check", "on_fail": "build"}
    },
    {
      "id": "pkg-check",
      "step": "4a.5",
      "gate": null,
      "title": "PKG completeness check (PKG-001〜015)",
      "dependsOn": ["p0-lint"],
      "entryHook": null,
      "exitHook": null,
      "condition": "kind == plugin-composition OR new_plugin_rollout",
      "resourceIds": [],
      "delegateSkill": "run-plugin-package-check",
      "fatal_exit_codes": [1],
      "handoff": "eval-log/handoff-after_pkg_check.json",
      "transition": {"gate": "条件非該当またはPKG completenessがPASS", "on_pass": "report", "on_fail": "abort"}
    },
    {
      "id": "report",
      "step": 7,
      "gate": null,
      "title": "完了レポート",
      "dependsOn": ["pkg-check"],
      "entryHook": null,
      "exitHook": null,
      "resourceIds": [
        "schemas/handoff.schema.json"
      ],
      "delegateSkill": null,
      "evaluation_receipts": [
        "eval-log/<plugin>/build/initial-draft-review/<artifact-fingerprint>/review.json",
        "eval-log/<plugin>/build/initial-draft-review/<artifact-fingerprint>/improvement-validation.json"
      ],
      "evaluation_receipts_comment": "evaluation_source.c1_c4 の receipt をそのまま転記する。無ければ未診断と書き、ここで評価 Agent を起動しない。",
      "fatal_exit_codes": [],
      "handoff": "eval-log/handoff-done.json",
      "transition": {"gate": "完了reportと全handoffがschema検証済み", "on_pass": "complete", "on_fail": "abort"}
    }
  ]
}
