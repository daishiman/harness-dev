{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness/run-build-skill/schemas/verification-contract.schema.json",
  "title": "Verification Obligation Contract",
  "description": "検証をAgent/思考法/routeの実行回数でなく、証明すべきclaimのDAGとして表す正本。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "obligations"],
  "properties": {
    "schema_version": {"const": 1},
    "subject": {"type": "string", "minLength": 1},
    "claim_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_claim_count", "assigned_claim_count", "execution_unit_count", "phase_gate_count", "unassigned_task_ids", "duplicate_task_ids", "assignment_sha256"],
      "properties": {
        "executable_claim_count": {"type": "integer", "minimum": 1},
        "assigned_claim_count": {"type": "integer", "minimum": 1},
        "execution_unit_count": {"type": "integer", "minimum": 1},
        "phase_gate_count": {"type": "integer", "minimum": 1},
        "unassigned_task_ids": {"type": "array", "maxItems": 0},
        "duplicate_task_ids": {"type": "array", "maxItems": 0},
        "assignment_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "proof_projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "dispatch", "required_claim_ids", "required_unit_ids", "proof_policy"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "dispatch": {"const": "none"},
          "required_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "required_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "proof_policy": {"const": "all-claims-done-with-unique-evidence-report-ref"}
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "kind", "risk", "activation", "depends_on", "inputs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"},
          "claim": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["generative", "deterministic", "semantic", "observational", "audit"]},
          "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "activation": {"type": "string", "enum": ["changed", "always", "exhaustive"]},
          "stage": {
            "type": "string",
            "enum": ["draft", "release"],
            "default": "draft",
            "description": "build stage。profile (証明の深さ) と直交する『どこまで作るか』の軸。draft=使える実体が立ち上がるまでに要る claim、release=現物が出てから効く claim (受入テスト設計・意味レビュー・監査・リリース準備)。未宣言は draft 扱い — 未分類を release へ倒すと stage を知らない旧 contract が draft で全 defer になり、何も作らない計画が黙って成立するため。fingerprint には含めない (draft の PASS receipt を release でそのまま再利用させ、昇格を追加実行だけで済ませる)。"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "required", "context"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "context": {"type": "boolean", "description": "true の入力だけをLLMの最小context sliceへ入れる。"}
              }
            }
          },
          "parameters": {"type": "object", "description": "path全体をhashせず、route固有の仕様sliceだけをfingerprintへ束縛するinline入力。"},
          "expected_evidence_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "model_required": {"type": "boolean", "description": "generative obligationがmodel contextを消費するか。"},
          "checker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "argv"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "observation_tier": {"type": "string", "enum": ["fork", "live"]},
          "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.8},
          "reuse": {"type": "boolean", "default": true}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "generative"}}},
            "then": {"required": ["model_required"]}
          },
          {
            "if": {"properties": {"kind": {"const": "deterministic"}}},
            "then": {"required": ["checker"]}
          },
          {
            "if": {"properties": {"kind": {"const": "audit"}}},
            "then": {"properties": {"activation": {"const": "exhaustive"}}}
          },
          {
            "if": {"properties": {"kind": {"const": "observational"}}},
            "then": {"required": ["observation_tier"]}
          }
        ]
      }
    }
  }
}
