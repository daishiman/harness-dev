{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-build-skill",
  "skill": "run-build-skill",
  "description": "新規/更新 Capability 構築のフェーズ定義。kind_filter はskill内部のサブ種別、capability_kind_filterはCapability 7 kind共通phaseに使う。全kindで現物の最小guardと提示を先に完了し、利用者が選ぶまでsemantic evaluatorを起動しない。",
  "artifact_delivery_contract": {
    "contract": "artifact-delivery-v1",
    "state_machine": {
      "initial": "artifact_created",
      "states": ["artifact_created", "minimal_guard_passed", "artifact_presented", "user_choice_recorded", "semantic_evaluator_started", "handoff_complete"],
      "transitions": [
        {"from": "artifact_created", "event": "minimum_guard_pass", "to": "minimal_guard_passed"},
        {"from": "minimal_guard_passed", "event": "present_actual_artifact", "to": "artifact_presented"},
        {"from": "artifact_presented", "event": "record_user_choice", "to": "user_choice_recorded"},
        {"from": "user_choice_recorded", "event": "accept-as-is", "to": "handoff_complete"},
        {"from": "user_choice_recorded", "event": "light|standard|detailed", "to": "semantic_evaluator_started"},
        {"from": "semantic_evaluator_started", "event": "improvement_complete", "to": "handoff_complete"}
      ],
      "pre_choice_forbidden": ["semantic-evaluator", "task-fork", "subagent", "multi-worker", "revise-loop"],
      "accept_contexts": {"evaluator": 0, "improver": 0}
    },
    "phase_activation": "all-legacy-phases-after-semantic_evaluator_started",
    "release": "explicit-only",
    "exhaustive": "explicit-only"
  },
  "phases": [
    {
      "id": "init-pre",
      "step": 0,
      "title": "kind 分岐ナビゲーション (Capability 7 kind → 適用フロー確定)",
      "capability_kind_filter": ["skill", "agent", "hook", "command", "plugin-composition", "prompt", "workflow"],
      "resourceIds": ["schema-template-selection"],
      "output_artifact": "(kind / skeleton / kind別lint 選択の決定のみ。ファイル成果物なし)",
      "note": "全 Capability 7 kind の入口 (SKILL.md Step 0)。kind=skillはinit以降のskill固有phaseへ、非skill kindは対応表のskeleton/出力先/lintへ進む。どちらもusable-draft proof後はCapability共通のinitial-draft-reviewへ合流する。"
    },
    {
      "id": "non-skill-build-lint",
      "step": 1,
      "title": "非skill Capabilityのkind別生成と決定論lint",
      "dependsOn": ["init-pre"],
      "capability_kind_filter": ["agent", "hook", "command", "plugin-composition", "prompt", "workflow"],
      "execution": "deterministic-capability-kind-router",
      "resourceIds": ["ref-build-steps"],
      "output_artifact": "kind別生成物 + eval-log/<plugin>/build/{generation-receipt.json,kind-lint-receipt.json,verification-plan.json}",
      "completion_gate": "generation-receipt.status=PASS AND kind-lint-receipt.status=PASS",
      "note": "kindごとのskeleton/出力先/lintは references/build-steps.md §I.1 を正本とする。本phaseはskill専用phaseの代替であり、kind=skillには適用しない。"
    },
    {
      "id": "init",
      "step": 1,
      "title": "要求ヒアリングと L0/L1 解決",
      "dependsOn": ["init-pre"],
      "kind_filter": ["run", "ref", "assign", "delegate", "wrap"],
      "resourceIds": ["ref-resource-map", "ref-build-steps", "schema-build-flags", "schema-build-plan"],
      "output_artifact": "eval-log/skill-brief.json + eval-log/build-plan.json",
      "note": "brief 確定直後に scripts/validate-build-plan.py --brief eval-log/skill-brief.json --out eval-log/build-plan.json で必須成果物集合 (flags/セクション/資産) を決定論導出する。build_stage は無指定で draft、release は第1稿確認後の明示昇格のみ。以降の flag_required 付き phase の要否はこの plan.flags が正本 (モデル判断でフラグを省略しない)。充足は Step 4 の --check と p0-gate が機械検査する。"
    },
    {
      "id": "scaffold",
      "step": 2,
      "title": "kind→template 展開 / update 差分読込",
      "dependsOn": ["init"],
      "kind_filter": ["run", "ref", "assign", "delegate", "wrap"],
      "resourceIds": ["schema-template-selection", "prompt-template-select", "prompt-scaffold"],
      "output_artifact": "plugins/<plugin>/skills/<skill>/SKILL.md"
    },
    {
      "id": "references",
      "step": 3,
      "title": "補助 references/ 生成",
      "dependsOn": ["scaffold"],
      "kind_filter": ["run", "ref", "assign", "delegate", "wrap"],
      "resourceIds": ["ref-build-steps"],
      "output_artifact": "plugins/<plugin>/skills/<skill>/references/"
    },
    {
      "id": "scripts",
      "step": 4,
      "title": "決定論 scripts と lint 実行",
      "dependsOn": ["references"],
      "kind_filter": ["run", "assign", "wrap", "delegate"],
      "resourceIds": ["schema-skill-build-trace"],
      "output_artifact": "eval-log/skill-build-trace.json",
      "verifier": "Step4 lint set including scripts/lint-feedback-contract.py --changed-only"
    },
    {
      "id": "templates",
      "step": 5,
      "title": "templates/_base + combinator 解決",
      "dependsOn": ["scaffold"],
      "kind_filter": ["run", "ref", "assign", "delegate", "wrap"],
      "resourceIds": ["schema-template-selection"],
      "output_artifact": "templates/"
    },
    {
      "id": "assets",
      "step": 6,
      "title": "examples/ assets/ 生成",
      "dependsOn": ["references"],
      "kind_filter": ["run", "ref", "assign", "wrap"],
      "resourceIds": [],
      "output_artifact": "examples/"
    },
    {
      "id": "prompts-emit",
      "step": 7,
      "title": "responsibility-slot ベースの prompt YAML 生成",
      "dependsOn": ["scaffold"],
      "kind_filter": ["run", "assign", "delegate"],
      "flag_required": "--with-prompts",
      "flag_source": "eval-log/build-plan.json#/flags/with_prompts (brief.responsibilities から決定論導出)",
      "resourceIds": ["schema-responsibility-slot", "prompt-responsibility-emit"],
      "output_artifact": "prompts/<R-id>.md"
    },
    {
      "id": "evaluator-emit",
      "step": 8,
      "title": "pair evaluator 同時生成",
      "dependsOn": ["scaffold"],
      "kind_filter": ["assign"],
      "flag_required": "--with-evaluator",
      "flag_source": "eval-log/build-plan.json#/flags/with_evaluator (brief.generate_pair_evaluator から決定論導出)",
      "resourceIds": ["schema-build-flags"],
      "output_artifact": "plugins/<plugin>/skills/<pair>/"
    },
    {
      "id": "trace-write",
      "step": 9,
      "title": "skill-build-trace.json 章別記入と検証",
      "dependsOn": ["scripts"],
      "kind_filter": ["run", "ref", "assign", "delegate", "wrap"],
      "resourceIds": ["schema-skill-build-trace", "prompt-trace-write"],
      "output_artifact": "eval-log/skill-build-trace.json",
      "note": "prompts-emit / evaluator-emit は flag_required の任意 phase。trace-write は必須 phase のため optional phase へ依存しない。任意成果物が存在する場合のみ trace に取り込む。loop実行系の feedback_contract は生成 SKILL.md frontmatter と trace の両方に固定する。"
    },
    {
      "id": "notion-register",
      "step": 10,
      "title": "Notion スキル一覧 DB へプラグイン情報を upsert (1:1 でヒアリングシート紐付け)",
      "dependsOn": ["trace-write"],
      "kind_filter": ["run", "ref", "assign", "delegate", "wrap"],
      "flag_required": "--notion-register",
      "resourceIds": [],
      "output_artifact": "scripts/notion-upsert-plugin.py --plugin <plugin> [--hearing-sheet-id <id>]",
      "note": "実体は top-level scripts/notion-upsert-plugin.py。冪等。token は .notion-config.json の keychain_service/keychain_account から取得し、CI では INTAKE_ALLOW_ENV_TOKEN=1 明示時のみ $NOTION_TOKEN を許可。"
    },
    {
      "id": "feedback-deploy",
      "step": 11,
      "title": "量産先プラグインに run-skill-feedback を実体コピー配備 (default-ON, deployment action)",
      "dependsOn": ["trace-write"],
      "kind_filter": ["run", "ref", "assign", "delegate", "wrap"],
      "default_on": true,
      "opt_out_flag": "--no-feedback-loop",
      "resourceIds": [],
      "output_artifact": "<target-plugin>/skills/run-skill-feedback (self-contained copy)",
      "verifier": "scripts/lint-feedback-protocol.py --strict (R7)",
      "note": "build 完了時に必ず実行。harness-creator 自身は対象外。冪等 (既存実体は再コピーしない、既存 symlink は実体へ置換)。これは SKILL.md patch combinator ではなく、scripts/render-combinators.py apply_feedback_loop() の副作用付き deployment action。"
    },
    {
      "id": "content-review",
      "step": 12,
      "title": "Verification obligation DAG 解決 (machine-first; semantic slicing)",
      "dependsOn": ["trace-write", "feedback-deploy"],
      "kind_filter": ["run", "ref", "assign", "delegate", "wrap"],
      "default_on": true,
      "opt_out_flag": "--skip-content-review",
      "resourceIds": ["schema-verification-contract", "schema-verification-evidence", "ref-verification-obligation-protocol", "schema-content-review-verdict", "ref-content-review-protocol"],
      "output_artifact": "eval-log/<plugin>/build/{verification-contract.json,verification-plan.json,obligation-evidence/*.json} + legacy content-review projections",
      "verifier": "scripts/lint-content-review.py --changed-only --base origin/main",
      "execution": "deterministic-resolver-then-local-llm-exception",
      "note": "derive-verification-contract.py でgraph全体をclaim DAG化し、plan-verification-obligations.py がexact proof reuse→deterministic check→未解決semantic batchの順に解決する。draft は generation/check だけを解決し usable-draft proof をartifact提示phaseへ渡す。LLM起動は release の llm_batches[]、または提示後の利用者診断choiceだけ。4条件/rubricは同じsemantic obligationで判定し、legacy 2 verdictへprojectionしてreceiptにも束縛する。30思考法3並列はexhaustive audit obligationのみ。"
    },
    {
      "id": "usable-draft-proof",
      "step": 12.4,
      "title": "全Capability共通usable-draft proof生成",
      "dependsOn": ["content-review", "non-skill-build-lint"],
      "dependency_mode": "applicable-capability-route",
      "upstream_by_capability_kind": {
        "skill": "content-review",
        "agent": "non-skill-build-lint",
        "hook": "non-skill-build-lint",
        "command": "non-skill-build-lint",
        "plugin-composition": "non-skill-build-lint",
        "prompt": "non-skill-build-lint",
        "workflow": "non-skill-build-lint"
      },
      "capability_kind_filter": ["skill", "agent", "hook", "command", "plugin-composition", "prompt", "workflow"],
      "stage_filter": ["draft"],
      "execution": "deterministic-applicable-route-proof",
      "producer": "scripts/build-usable-draft-proof.py --verification-plan <verification-plan.json> --capability-kind <kind> --capability-artifact <repo-relative-capability-artifact> --upstream-receipt <receipt.json> [--upstream-receipt <receipt.json>] --repo-root <root> --out <usable-draft-proof.json>",
      "resourceIds": ["ref-verification-obligation-protocol", "schema-usable-draft-proof", "script-build-usable-draft-proof", "script-validate-build-trace"],
      "output_artifact": "eval-log/<plugin>/build/usable-draft-proof.json (status=PASS, capability_kind, capability artifact path/sha256, public validator identity/mode/sha256/exit/stdout digest, upstream provenance)",
      "completion_gate": "producer.exit_code=0 AND usable-draft-proof.status=PASS AND artifact-validation.exit_code=0 AND artifact-validation.valid=true AND artifact-validation.reported_kind=capability_kind",
      "note": "dependsOnのうちcurrent capability kindに適用されるupstreamを1つだけprovenanceとして要求する。truth sourceはtarget manifestに含まれる実capability artifactと正本validate-build-trace.pyの実行結果である。plugin-compositionは--bundle、他の6 kindは--manifestで検証し、skillのrun/ref/assign/wrap/delegate subtypeはreported_kind=skillへ正規化する。"
    },
    {
      "id": "artifact-present-handoff",
      "step": 12.45,
      "title": "実Capability artifactの最小guardと利用者への提示",
      "dependsOn": ["usable-draft-proof"],
      "capability_kind_filter": ["skill", "agent", "hook", "command", "plugin-composition", "prompt", "workflow"],
      "stage_filter": ["draft"],
      "execution": "class-specific-minimal-guard-then-present",
      "guard_order": ["parse-or-open", "secret-scan", "irreversible-operation-gate", "corruption-check"],
      "events": ["artifact_created", "minimal_guard_passed", "artifact_presented"],
      "resourceIds": ["schema-artifact-presentation-receipt"],
      "output_artifact": "eval-log/<plugin>/build/artifact-handoff.json (actual artifact path/hash, guard receipts, presentation timestamp)",
      "completion_gate": "actual artifact exists AND minimal guards PASS AND artifact_presented_at > artifact_created_at",
      "note": "利用可能な現物と開き方/試し方をここで先に渡す。意味評価・30思考法・改善は本phaseの完了条件ではない。"
    },
    {
      "id": "diagnostic-choice",
      "step": 12.5,
      "title": "提示後の利用者診断深度選択",
      "dependsOn": ["artifact-present-handoff"],
      "capability_kind_filter": ["skill", "agent", "hook", "command", "plugin-composition", "prompt", "workflow"],
      "stage_filter": ["draft"],
      "execution": "user-choice-after-presentation",
      "choices": ["accept-as-is", "light", "standard", "detailed"],
      "accept_as_is_evaluator_contexts": 0,
      "accept_as_is_improver_contexts": 0,
      "resourceIds": ["schema-pre-diagnostic-choice-event"],
      "output_artifact": "eval-log/<plugin>/build/diagnostic-choice.json",
      "completion_gate": "artifact_presented event exists before host-recorded user_choice_recorded event",
      "note": "通常は現物提示後に深度を聞く。今回依頼のように30思考法監査が明示済みの場合は、その現在turn限定選択をreceipt化するが、将来draftへ自動継承しない。"
    },
    {
      "id": "initial-draft-review",
      "step": 12.6,
      "title": "選択時のみ全Capability共通semantic診断",
      "dependsOn": ["diagnostic-choice"],
      "capability_kind_filter": ["skill", "agent", "hook", "command", "plugin-composition", "prompt", "workflow"],
      "stage_filter": ["draft"],
      "default_on": false,
      "trigger": "explicit current-request audit OR pre-diagnostic choice in light|standard|detailed",
      "execution": "post-choice-single-read-only-evaluator",
      "single_active_delivery_lease_per_artifact_contract": true,
      "stale_lease_redelivery": "same-idempotency-identity",
      "completed_receipt_reuse": true,
      "delivery_semantics": "lease-with-idempotent-redelivery",
      "exactly_once_result_guaranteed": false,
      "entry_gate": "usable-draft-proof.status=PASS AND artifact_presented=true AND user_choice_recorded=true AND diagnostic_authorized=true",
      "launcher": "scripts/build-review-launch.py",
      "max_active_launch_leases_per_harness": 1,
      "resourceIds": ["schema-usable-draft-proof", "schema-artifact-presentation-receipt", "schema-pre-diagnostic-choice-event", "schema-review-launch-request", "schema-initial-draft-review", "schema-improvement-user-event", "schema-improvement-decision", "ref-improvement-levels", "prompt-initial-draft-evaluate", "script-build-review-launch", "agent-initial-draft-evaluator"],
      "output_artifact": "eval-log/<plugin>/build/initial-draft-review/<artifact-fingerprint>/{launch-request.json,review.json,improvement-decision.json,gate-plan.json} + <state_ref>.launch.json",
      "verifier": "scripts/build-improvement-gate.py --verification-plan <verification-plan.json> --usable-draft-proof <usable-draft-proof.json> --artifact-presentation-receipt <artifact-presentation.json> --pre-diagnostic-choice-event <pre-diagnostic-choice.json> [...required gate arguments]",
      "note": "skill subtypeに限定しない。artifact created < presented < evaluator eventをlauncher入力で検査し、accept-as-isはevaluator 0 contextのまま完了する。複数componentのharness全体を1つのtarget manifestとして束ね、artifact+contract fingerprintごとに同時active delivery leaseは1つだけ。現在turnの明示30監査は起動できるが、そのreceiptから将来draftの自動診断を導出しない。release/exhaustive自動昇格はfalse固定。"
    },
    {
      "id": "bounded-improvement",
      "step": 12.7,
      "title": "ユーザー選択範囲だけの有界改善",
      "dependsOn": ["initial-draft-review"],
      "capability_kind_filter": ["skill", "agent", "hook", "command", "plugin-composition", "prompt", "workflow"],
      "stage_filter": ["draft"],
      "execution": "single-bounded-improvement-executor",
      "executor": "elegant-bounded-improvement-executor",
      "trigger": "improvement-decision.improvement_authorized=true AND selected_finding_ids is non-empty",
      "accept_draft_executor_contexts": 0,
      "max_executor_contexts": 1,
      "resourceIds": ["prompt-bounded-improve", "schema-improvement-result", "agent-bounded-improvement-executor"],
      "output_artifact": "eval-log/<plugin>/build/initial-draft-review/<artifact-fingerprint>/{post-target-manifest.json,improvement-result.json}",
      "note": "accept-draftはexecutorを起動せずusable draftで停止。他levelもdecisionのselected_finding_ids/max_roundsだけを1 workerが処理する。release/exhaustiveはuser eventへ束縛された明示decisionにnext_stage/next_profileがある場合だけ後続候補になる。"
    },
    {
      "id": "post-improvement-verification",
      "step": 12.8,
      "title": "bounded improvementの閉集合・diff・C1-C4再検証",
      "dependsOn": ["bounded-improvement"],
      "capability_kind_filter": ["skill", "agent", "hook", "command", "plugin-composition", "prompt", "workflow"],
      "stage_filter": ["draft"],
      "execution": "deterministic-post-improvement-verifier",
      "verifier": "scripts/validate-improvement-result.py --gate-state <state_ref> --target-root <target_root> [...required receipt arguments]",
      "promotion_source": "improvement-decision.json",
      "auto_promote_release": false,
      "auto_promote_exhaustive": false,
      "resourceIds": ["schema-improvement-result", "script-validate-improvement-result"],
      "output_artifact": "eval-log/<plugin>/build/initial-draft-review/<artifact-fingerprint>/improvement-validation.json",
      "note": "resultがselected setの閉集合、round上限、manifest diff、source trace、C1-C4を満たした場合だけcomplete。incomplete/blockedでは追加Agentやstage昇格を起動しない。release/exhaustiveへ進める値はdecision receiptからのみ投影する。"
    },
    {
      "id": "live-acceptance",
      "step": 13,
      "title": "実走 acceptance (live-trial, Gate D) — behavioral trait 該当 skill のみ条件発火",
      "dependsOn": ["content-review"],
      "kind_filter": ["run", "assign", "delegate", "wrap"],
      "default_on": false,
      "execution": "local-only",
      "trigger": {
        "acceptance_tier": "live",
        "behavioral_sha_changed": true,
        "budget_within": true
      },
      "unconditional": ["proof"],
      "resourceIds": [],
      "output_artifact": "eval-log/<plugin>/<skill>/live-trial/<run-id>/{verdict.json, transcript.jsonl}",
      "verifier": "scripts/lint-live-trial-verdict.py --plugin <plugin> (D13 record-only WARN。P3 常設化 go/no-go で --enforce へ昇格)",
      "note": "draft では起動せず release へ繰り越す。release で Step12 resolverのobservational_queue[]に入ったobligationだけを実走する。plan-live-trials.py はlive executor adapterとして対象skill内で挙動closure/transcript proofを再確認するが、plugin全skillを独自にfan-outしない。incremental既定のtrial/同時実行上限は暴走安全弁。exhaustive明示時のみ全candidate再実走。非発火はdeferred記録。リモートCIは実走せず証跡を機械検査する。"
    }
  ],
  "resources": [
    {"id": "ref-resource-map", "kind": "reference", "path": "./references/resource-map.yaml", "phaseIds": ["init"]},
    {"id": "ref-build-steps", "kind": "reference", "path": "./references/build-steps.md", "phaseIds": ["non-skill-build-lint", "init", "references"]},
    {"id": "schema-template-selection", "kind": "schema", "path": "./schemas/template-selection.schema.json", "phaseIds": ["init-pre", "scaffold", "templates"]},
    {"id": "schema-skill-build-trace", "kind": "schema", "path": "./schemas/skill-build-trace.schema.json", "phaseIds": ["scripts", "trace-write"]},
    {"id": "schema-responsibility-slot", "kind": "schema", "path": "./schemas/responsibility-slot.schema.json", "phaseIds": ["prompts-emit"]},
    {"id": "schema-build-flags", "kind": "schema", "path": "./schemas/build-flags.schema.json", "phaseIds": ["init", "evaluator-emit"]},
    {"id": "schema-build-plan", "kind": "schema", "path": "./schemas/build-plan.schema.json", "phaseIds": ["init", "scripts"]},
    {"id": "schema-content-review-verdict", "kind": "schema", "path": "./schemas/content-review-verdict.schema.json", "phaseIds": ["content-review"]},
    {"id": "schema-verification-contract", "kind": "schema", "path": "./schemas/verification-contract.schema.json", "phaseIds": ["content-review"]},
    {"id": "schema-verification-evidence", "kind": "schema", "path": "./schemas/verification-evidence.schema.json", "phaseIds": ["content-review"]},
    {"id": "schema-route-build-report", "kind": "schema", "path": "./schemas/route-build-report.schema.json", "phaseIds": ["trace-write"]},
    {"id": "ref-route-build-report", "kind": "reference", "path": "./references/route-build-report.md", "phaseIds": ["trace-write"]},
    {"id": "ref-content-review-protocol", "kind": "reference", "path": "./references/content-review-protocol.md", "phaseIds": ["content-review"]},
    {"id": "ref-verification-obligation-protocol", "kind": "reference", "path": "./references/verification-obligation-protocol.md", "phaseIds": ["content-review", "usable-draft-proof"]},
    {"id": "ref-improvement-levels", "kind": "reference", "path": "./references/improvement-levels.json", "phaseIds": ["initial-draft-review"]},
    {"id": "schema-review-launch-request", "kind": "schema", "path": "./schemas/review-launch-request.schema.json", "phaseIds": ["initial-draft-review"]},
    {"id": "schema-initial-draft-review", "kind": "schema", "path": "./schemas/initial-draft-review.schema.json", "phaseIds": ["initial-draft-review"]},
    {"id": "schema-improvement-user-event", "kind": "schema", "path": "./schemas/improvement-user-event.schema.json", "phaseIds": ["initial-draft-review"]},
    {"id": "schema-improvement-decision", "kind": "schema", "path": "./schemas/improvement-decision.schema.json", "phaseIds": ["initial-draft-review"]},
    {"id": "schema-improvement-result", "kind": "schema", "path": "./schemas/improvement-result.schema.json", "phaseIds": ["bounded-improvement", "post-improvement-verification"]},
    {"id": "schema-usable-draft-proof", "kind": "schema", "path": "./schemas/usable-draft-proof.schema.json", "phaseIds": ["usable-draft-proof", "initial-draft-review"]},
