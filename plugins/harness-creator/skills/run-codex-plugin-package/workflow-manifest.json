{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "workflowId": "run-codex-plugin-package",
  "skill": "run-codex-plugin-package",
  "description": "Claude pluginの実体からCodex manifestとrepository marketplaceを決定論的に同期し、単独配布可能性を検証する。",
  "goal_seek": {
    "engine": "inline",
    "spec": "eval-log/goal-spec.json",
    "progress": "eval-log/run-codex-plugin-package-progress.json",
    "intermediate": "eval-log/run-codex-plugin-package-intermediate.jsonl",
    "max_loops": 3,
    "fork": "subagent"
  },
  "phases": [
    {
      "id": "preflight",
      "step": 1,
      "title": "plugin identity・source contract・対象scopeを確定",
      "prompt": "./prompts/R1-package.md",
      "output_artifact": "eval-log/codex-plugin-package-preflight.json",
      "transition": {
        "gate": "plugin path・manifest name・package contractが対象scopeと一致",
        "on_pass": "check-drift",
        "on_fail": "abort"
      },
      "failure_action": "abort"
    },
    {
      "id": "check-drift",
      "step": 2,
      "title": "書込み前のplatform driftをread-only検査",
      "dependsOn": ["preflight"],
      "prompt": "./prompts/R1-package.md",
      "validation": [
        "python3 ${PLUGIN_ROOT}/scripts/sync-plugin-platforms.py --repo-root . --plugin plugins/${plugin} --check"
      ],
      "output_artifact": "eval-log/codex-plugin-package-drift.json",
      "transition": {
        "gate": "read-only checkがdriftを機械可読に報告し、入力違反がない",
        "on_pass": "apply",
        "on_fail": "abort"
      },
      "failure_action": "record_and_continue"
    },
    {
      "id": "apply",
      "step": 3,
      "title": "generatorでmanifestとmarketplace entryを不可分にupsert",
      "dependsOn": ["check-drift"],
      "prompt": "./prompts/R1-package.md",
      "output_artifact": "eval-log/codex-plugin-package-apply.json",
      "transition": {
        "gate": "generatorが検証済み候補をatomic upsertし部分書きを残さない",
        "on_pass": "verify",
        "on_fail": "abort"
      },
      "failure_action": "abort"
    },
    {
      "id": "verify",
      "step": 4,
      "title": "再check・資産参照・plugin境界を検証",
      "dependsOn": ["apply"],
      "prompt": "./prompts/R1-package.md",
      "validation": [
        "python3 ${PLUGIN_ROOT}/scripts/sync-plugin-platforms.py --repo-root . --plugin plugins/${plugin} --check",
        "python3 ${PLUGIN_ROOT}/scripts/audit-capability-parity.py --repo-root . --plugin ${plugin}"
      ],
      "output_artifact": "eval-log/codex-plugin-package-verify.json",
      "transition": {
        "gate": "platform check exit 0 and capability parity PASS and outside-root symlink count=0",
        "on_pass": "handoff",
        "on_fail": "abort"
      },
      "failure_action": "abort"
    },
    {
      "id": "handoff",
      "step": 5,
      "title": "検証済み生成物とinstall境界を引き渡す",
      "dependsOn": ["verify"],
    "output_artifact": "eval-log/handoff-run-codex-plugin-package.json",
    "handoff_to": {
      "skill": "run-codex-plugin-install",
      "required_inputs": [
        "source",
        "plugin",
        "ref (Git source only)"
      ],
      "behavioral_verification": "downstream install skill owns live install and CLI receipt verification"
    },
    "transition": {
      "gate": "検証証拠、install未実行境界、run-codex-plugin-installへのsource/plugin/ref入力契約が引渡しに明示",
        "on_pass": "complete",
        "on_fail": "abort"
      },
      "failure_action": "abort"
    }
  ],
  "completion_signals": {
    "required_phases": ["preflight", "check-drift", "apply", "verify", "handoff"],
    "platform_check_exit": 0,
    "capability_parity": "PASS",
    "outside_root_symlinks": 0,
    "user_global_mutations": 0
  },
  "fatal_exit_codes": [2, 3]
}
