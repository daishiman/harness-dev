  "open_issues": [
    {
      "id": "GAP-ENVELOPE-001",
      "title": "manifest 適用 executor の不在",
      "detail": "envelope-draft/plugin.json を plugins/guide-doc-generator/.claude-plugin/plugin.json へ適用する executor が無い。適用は人手承認で行う",
      "owner": "human maintainer"
    },
    {
      "id": "GAP-SCRIPT-BUILDER",
      "title": "script builder が contract-only",
      "detail": "plugin-scaffold は planner 上の routing 語彙であり実行実体を持たない。plugin-root へ hoist する script 群は scaffold 後に人手または後段 executor が実装する",
      "owner": "human maintainer"
    },
    {
      "id": "GAP-SRG-CONTRACT-DRIFT",
      "title": "画像生成委譲先の契約ドリフト監視が無い",
      "detail": "委譲先 slide-report-generator の画像パイプラインは node 実装で、本 plugin の Python 標準ライブラリ制約の外にある。入力となる画像計画スキーマが委譲先で変更されても本 plugin 側は検知できない。委譲アダプタは不在時 skip の fail-soft を持つが、契約変更時は skip ではなく誤動作になりうる",
      "owner": "guide-doc-generator maintainer"
    },
    {
      "id": "GAP-DEFAULT-OUTPUT-DIR",
      "title": "既定出力先の実値は設置時供給",
      "detail": "既定出力先は plugin 同梱の設定ファイルでキーのみ宣言し、実際のパスは設置先が供給する。plan には絶対パスを焼かない。未設定時は起動引数での明示を必須にする",
      "owner": "human maintainer"
    }
  ]
}
