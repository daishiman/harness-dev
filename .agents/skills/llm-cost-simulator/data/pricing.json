{
  "meta": {
    "schema_version": "1.0",
    "currency": "USD",
    "unit": "per_1M_tokens",
    "description": "LLM API pricing table for llm-cost-simulator. All prices are USD per 1,000,000 tokens unless a model overrides 'unit'. Multipliers (cache/batch) are applied to the relevant base price. ALWAYS verify non-Anthropic prices against the official pricing page before trusting a cost estimate — see 'refresh' below. Add new models/providers by appending entries; the engine reads this file at runtime.",
    "confidence_levels": {
      "authoritative": "Sourced from a first-party reference bundled with this environment (e.g. the claude-api skill). Trust as-is.",
      "verify": "Best-known public price at as_of date; provider may have changed it. Refresh before a real ROI decision.",
      "estimate": "Approximate / placeholder. MUST be refreshed from the official page before use."
    },
    "refresh": {
      "how": "Use WebFetch on the provider pricing URL, extract input/output/cached prices per 1M tokens, then edit this file. Re-run the simulation afterwards.",
      "anthropic": "https://platform.claude.com/docs/en/pricing  (or the bundled claude-api skill: shared/models.md)",
      "openai": "https://openai.com/api/pricing/  (and https://platform.openai.com/docs/pricing)",
      "google": "https://ai.google.dev/gemini-api/docs/pricing",
      "openrouter_aggregator": "https://openrouter.ai/models  (cross-provider sanity check)"
    }
  },

  "provider_defaults": {
    "anthropic": {
      "cache_read_mult": 0.1,
      "cache_write_5m_mult": 1.25,
      "cache_write_1h_mult": 2.0,
      "batch_mult": 0.5,
      "notes": "Cache read ~0.1x base input; 5m write 1.25x, 1h write 2.0x. Batch API = 50% off. Extended-thinking / reasoning tokens are billed at the OUTPUT rate."
    },
    "openai": {
      "cache_read_mult": 0.5,
      "cache_write_5m_mult": 1.0,
      "cache_write_1h_mult": 1.0,
      "batch_mult": 0.5,
      "notes": "Automatic prompt caching: cached input tokens ~50% off, no write premium. Batch API = 50% off. Reasoning (o-series / gpt-5 thinking) tokens billed at OUTPUT rate. Confirm per-model 'cached_input' when present."
    },
    "google": {
      "cache_read_mult": 0.25,
      "cache_write_5m_mult": 1.0,
      "cache_write_1h_mult": 1.0,
      "batch_mult": 0.5,
      "notes": "Context caching ~75% off cached tokens, plus a separate storage charge per token-hour NOT modeled here. Some models use tiered pricing above a context threshold (see context_tiers). Batch API = 50% off. Verify."
    },
    "generic": {
      "cache_read_mult": 0.5,
      "cache_write_5m_mult": 1.0,
      "cache_write_1h_mult": 1.0,
      "batch_mult": 1.0,
      "notes": "Conservative defaults for providers without modeled caching/batch."
    }
  },

