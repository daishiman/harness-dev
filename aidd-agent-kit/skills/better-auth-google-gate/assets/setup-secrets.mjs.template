#!/usr/bin/env node
import { randomBytes } from "node:crypto";
import { spawn, spawnSync } from "node:child_process";
import { access, appendFile, chmod, readFile, writeFile } from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";

const PROJECT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const LOCAL_ORIGIN = __LOCAL_ORIGIN_JSON__;
const CLOUDFLARE_TARGET = __CLOUDFLARE_TARGET_JSON__;
const CLOUDFLARE_ARGS = __CLOUDFLARE_ARGS_JSON__;
const NPX = process.platform === "win32" ? "npx.cmd" : "npx";
const LOCAL_ONLY = process.argv.includes("--local-only");
const DRY_RUN = process.argv.includes("--dry-run");

async function exists(file) {
  try { await access(file); return true; } catch { return false; }
}

async function readHidden(label) {
  if (!process.stdin.isTTY || typeof process.stdin.setRawMode !== "function") {
    throw new Error("対話Terminalから実行してください。");
  }
  process.stdout.write(`${label}（入力内容は表示されません）: `);
  const wasRaw = Boolean(process.stdin.isRaw);
  process.stdin.setEncoding("utf8");
  process.stdin.setRawMode(true);
  process.stdin.resume();

  return new Promise((resolve, reject) => {
    let value = "";
    const finish = (error) => {
      process.stdin.off("data", onData);
      process.stdin.setRawMode(wasRaw);
      process.stdin.pause();
      process.stdout.write("\n");
      error ? reject(error) : resolve(value);
    };
    const onData = (chunk) => {
      for (const character of chunk) {
        if (character === "\u0003") return finish(new Error("中止しました。"));
        if (character === "\r" || character === "\n") return finish();
        if (character === "\u007f" || character === "\b") {
          value = value.slice(0, -1);
        } else {
          value += character;
        }
      }
    };
    process.stdin.on("data", onData);
  });
}

function setDotenvValues(content, values) {
  const remaining = new Set(Object.keys(values));
  const lines = content.split(/\r?\n/).filter((line, index, rows) => index < rows.length - 1 || line !== "");
  const updated = lines.map((line) => {
    const match = line.match(/^([A-Z][A-Z0-9_]*)=/);
    if (!match || !(match[1] in values)) return line;
    remaining.delete(match[1]);
    return `${match[1]}=${values[match[1]]}`;
  });
  for (const key of remaining) updated.push(`${key}=${values[key]}`);
  return `${updated.join("\n")}\n`;
}

function runWrangler(args, options = {}) {
  const result = spawnSync(NPX, ["wrangler", ...args], {
    cwd: PROJECT,
    encoding: "utf8",
    stdio: options.capture ? ["ignore", "pipe", "pipe"] : "inherit",
  });
  if (result.error) throw result.error;
  if (result.status !== 0) {
    if (options.capture && result.stderr) process.stderr.write(result.stderr);
    throw new Error(`Wranglerコマンドに失敗しました: ${args.join(" ")}`);
  }
  return result.stdout || "";
}

function putSecret(key, value) {
  const command = CLOUDFLARE_TARGET === "pages"
    ? ["wrangler", "pages", "secret", "put", key, ...CLOUDFLARE_ARGS]
    : ["wrangler", "secret", "put", key, ...CLOUDFLARE_ARGS];
  return new Promise((resolve, reject) => {
    const child = spawn(NPX, command, { cwd: PROJECT, stdio: ["pipe", "inherit", "inherit"] });
    child.once("error", reject);
    child.once("exit", (code) => code === 0 ? resolve() : reject(new Error(`${key}の登録に失敗しました。`)));
    child.stdin.end(`${value}\n`);
  });
}

async function main() {
  if (DRY_RUN) {
    console.log("✓ OS共通の非表示入力でローカルとCloudflareへ登録します。値は表示しません。");
    return;
  }
  const clientId = await readHidden("Google Client IDを貼り付けてEnter");
  if (!clientId.endsWith(".apps.googleusercontent.com")) throw new Error("Client IDの形式が正しくありません。");
  const clientSecret = await readHidden("Google Client Secretを貼り付けてEnter");
  if (!clientSecret) throw new Error("Client Secretが空です。");

  const devVars = path.join(PROJECT, ".dev.vars");
  const envFile = path.join(PROJECT, ".env");
  const localFile = await exists(devVars) ? devVars : (await exists(envFile) ? envFile : devVars);
  const ignorePattern = localFile === envFile ? ".env*" : ".dev.vars*";
  const gitignore = path.join(PROJECT, ".gitignore");
  const ignoreContent = await exists(gitignore) ? await readFile(gitignore, "utf8") : "";
  if (!ignoreContent.split(/\r?\n/).includes(ignorePattern)) {
    await appendFile(gitignore, `${ignoreContent && !ignoreContent.endsWith("\n") ? "\n" : ""}${ignorePattern}\n`);
  }

  const current = await exists(localFile) ? await readFile(localFile, "utf8") : "";
  const localSecretMatch = current.match(/^BETTER_AUTH_SECRET=(.+)$/m);
  const localSecret = localSecretMatch?.[1] || randomBytes(48).toString("base64url");
  const next = setDotenvValues(current, {
    BETTER_AUTH_SECRET: localSecret,
    BETTER_AUTH_URL: LOCAL_ORIGIN,
    GOOGLE_CLIENT_ID: clientId,
    GOOGLE_CLIENT_SECRET: clientSecret,
  });
  await writeFile(localFile, next, { encoding: "utf8", mode: 0o600 });
  await chmod(localFile, 0o600).catch(() => {});
  console.log(`✓ ローカル設定: ${path.basename(localFile)}`);

  if (LOCAL_ONLY) {
    console.log("完了しました。Secretの値は表示・送信していません。");
    return;
  }

  runWrangler(["whoami"]);
  const listArgs = CLOUDFLARE_TARGET === "pages"
    ? ["pages", "secret", "list", ...CLOUDFLARE_ARGS]
    : ["secret", "list", ...CLOUDFLARE_ARGS, "--format", "json"];
  const secretList = runWrangler(listArgs, { capture: true });
  if (!secretList.includes("BETTER_AUTH_SECRET")) {
    await putSecret("BETTER_AUTH_SECRET", randomBytes(48).toString("base64url"));
  }
  await putSecret("GOOGLE_CLIENT_ID", clientId);
  await putSecret("GOOGLE_CLIENT_SECRET", clientSecret);

  console.log("✓ Cloudflare本番設定");
  console.log("完了しました。Secretの値は表示・送信していません。");
}

main().catch((error) => {
  console.error(`エラー: ${error.message}`);
  process.exitCode = 1;
});
