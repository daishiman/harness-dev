{
  "schema_version": 1,
  "profile_id": "jp-web-design/catalog-default",
  "profile_version": "1.0.0",
  "default_mode": "hiraga-liquid-glass",
  "source": {
    "catalog": "assets/reference/catalog.html",
    "component_css": "assets/reference/styles.css",
    "token_css": "assets/hiraga/hiraga-color-system.css",
    "interaction_reference": "assets/reference/reference-interactions.js"
  },
  "adoption": {
    "new_visual_app": "apply",
    "existing_visual_app": "report-only-unless-eligible",
    "non_visual_app": "not-applicable",
    "alternate_brand": "report-only"
  },
  "generated_artifacts": {
    "token_css": "src/styles/aidd/hiraga-color-system.css",
    "component_css": "src/styles/aidd/catalog-default.css",
    "design_profile": "docs/product/design-profile.json",
    "runtime_scenarios": "docs/product/design-runtime-scenarios.json",
    "runtime_evidence": "docs/product/design-runtime-evidence.json",
    "conformance_report": "docs/product/design-conformance.json"
  },
  "v0_machine_baseline": [
    "canonical-assets-match",
    "entry-css-imports-default",
    "profile-provenance-current",
    "declared-components-exist-in-source",
    "light-theme-only",
    "sample-copy-not-imported"
  ],
  "component_markers": {
    "app-shell": "app-shell",
    "navigation": "side-nav",
    "button": "btn",
    "field": "field",
    "selection": "chip",
    "table": "table-scroll",
    "status": "badge",
    "modal": "modal",
    "toast": "toast",
    "empty-state": "empty-state"
  },
  "v1_runtime_baseline": {
    "viewports": [375, 768, 1280, 1600],
    "checks": [
      "no_horizontal_overflow",
      "body_and_controls_at_least_16px",
      "controls_at_least_44px",
      "inputs_have_visible_boundaries",
      "no_persistent_supplemental_copy",
      "reduced_motion_preserves_meaning",
      "keyboard_and_pointer_paths_work",
      "liquid_glass_material_present",
      "declared_screen_is_rendered",
      "responsive_navigation_present"
    ]
  },
  "visible_copy_allowlist": [
    "heading",
    "label",
    "value",
    "status",
    "field_error_with_recovery",
    "next_action",
    "irreversible_warning"
  ],
  "small_text_exemptions": [
    ".unit",
    ".currency",
    ".num-sep"
  ],
  "never_copy_from_reference": [
    "sample_records",
    "sample_explanations",
    "implementation_notes",
    "debug_text"
  ],
  "consumer_source_denylist": [
    "練馬区 一棟マンション",
    "川口市 一棟アパート",
    "船橋市 一棟アパート",
    "taro@example.com",
    "sato@example",
    "東京23区",
    "首都圏",
    "関西圏",
    "地元(和歌山県)",
    "田中様",
    "提案内容を確認中です。",
    "7月22日にご連絡します。",
    "123,456,789円",
    "目標120通に対する実績",
    "+7.4pt",
    "まだ物件の登録がありません",
    "概要書から登録する"
  ]
}
