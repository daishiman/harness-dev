{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"plugins/harness-creator/scripts/hook-router.py\" --event PostToolUse --host codex # harness-managed:hook-router:PostToolUse",
            "type": "command"
          }
        ],
        "matcher": "apply_patch|exec_command|shell_command"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"plugins/harness-creator/scripts/hook-router.py\" --event PreToolUse --host codex # harness-managed:hook-router:PreToolUse",
            "type": "command"
          }
        ],
        "matcher": "apply_patch|exec_command|shell_command"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python3 \"plugins/harness-creator/scripts/hook-router.py\" --event SessionEnd --host codex # harness-managed:hook-router:SessionEnd",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "command": "python3 \"plugins/harness-creator/scripts/hook-router.py\" --event SessionStart --host codex # harness-managed:hook-router:SessionStart",
            "type": "command"
          }
        ],
        "matcher": "clear|resume|startup"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"plugins/harness-creator/scripts/hook-router.py\" --event Stop --host codex # harness-managed:hook-router:Stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bd codex-hook UserPromptSubmit",
            "statusMessage": "Refreshing Beads context",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python3 \"plugins/harness-creator/scripts/hook-router.py\" --event UserPromptSubmit --host codex # harness-managed:hook-router:UserPromptSubmit",
            "type": "command"
          }
        ]
      }
    ]
  }
}
