+# -*- coding: utf-8 -*-
+"""解説パネル (EXPLAIN) の逆抽出。
+
+EXPLAIN は「大きな絵 + 少ない言葉」を 1 情報単位ぶん抱える部品で、絵そのものは
+入れ子の図解 / 画像が持つ。ここで固定するのは 2 点。
+
+1. 外側は参照側として復元される — headline / note / diagram_id が戻り、入れ子の
+   図解が DIAGRAM 部品として二重に現れない。
+2. 内側の実体は拾われる — diagrams[] は入れ子から復元される。部品の走査は
+   data-hb-part で止まるが、レジストリの走査は部分木全体を歩くため。
+"""
+
+import _harness as H
+
+
+class ExplainPartExtraction(H.C20TestCase):
+
+    def extract_explain(self):
+        res, _ = self.extract(H.full_html(
+            sections=[H.section_html("intro", parts=H.part_explain())]))
+        self.assert_exit(res, 0)
+        return self.read_out()
+
+    def parts(self, cfg):
+        return cfg["sections"][0]["parts"]
+
+    def test_explain_part_is_restored_with_its_words(self):
+        parts = self.parts(self.extract_explain())
+        self.assertEqual(1, len(parts), "解説パネル以外の部品が増えている: %r" % parts)
+        self.assertEqual("EXPLAIN", parts[0]["part"])
+        self.assertEqual("ここから始める", parts[0]["data"]["headline"])
+        self.assertEqual("右上のボタンが入口", parts[0]["data"]["note"])
+
+    def test_visual_is_kept_as_a_reference_not_inlined(self):
+        """絵は id 参照で戻る (解説パネルの data に図解の中身が展開されない)。"""
+        data = self.parts(self.extract_explain())[0]["data"]
+        self.assertEqual("flow-1", data["diagram_id"])
+        self.assertNotIn("pattern", data)
+        self.assertNotIn("data", data)
+
+    def test_nested_diagram_entity_is_recovered(self):
+        diagrams = self.extract_explain().get("diagrams") or []
+        self.assertEqual(1, len(diagrams))
+        self.assertEqual("flow-1", diagrams[0]["id"])
+        self.assertEqual(H.DIAGRAM_DATA, diagrams[0]["data"])
