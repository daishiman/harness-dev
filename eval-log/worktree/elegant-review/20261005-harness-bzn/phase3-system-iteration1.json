      "status": "implemented",
      "change": "_resolve_target_pathをWrite/Edit/Bashのauthority判定へ共用。root基準相対pathとsymlink実体を同じ経路で解決し、確定/draft/reopen aliasを別々に検証。",
      "regression_tests": [
        "test_direct_tools_use_symlink_authority",
        "test_bash_noncanonical_nested_fixture_and_foreign_project_pass"
      ]
    },
    {
