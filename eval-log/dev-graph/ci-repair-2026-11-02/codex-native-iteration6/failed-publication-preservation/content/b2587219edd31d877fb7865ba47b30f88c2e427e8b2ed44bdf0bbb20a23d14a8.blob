 \\\"pass\\\", \\\"implementation_readiness\\\": {\\\"checked_at\\\": \\\"2026-09-07T05:00:00Z\\\", \\\"missing_sections\\\": [], \\\"status\\\": \\\"complete\\\"}, \\\"depends_on\\\": [\\\"task-api-users\\\"], \\\"resource_scope\\\": [\\\"tests/e2e/users/\\\"], \\\"tracker_binding\\\": \\\"none\\\"}\\n{\\\"graph_node_id\\\": \\\"task-release-gate\\\", \\\"artifact_kind\\\": \\\"task\\\", \\\"parent_feature\\\": null, \\\"status\\\": \\\"blocked\\\", \\\"confirmation_status\\\": \\\"confirmed\\\", \\\"evaluation_status\\\": \\\"pass\\\", \\\"implementation_readiness\\\": {\\\"checked_at\\\": \\\"2026-09-07T05:00:00Z\\\", \\\"missing_sections\\\": [], \\\"status\\\": \\\"complete\\\"}, \\\"depends_on\\\": [\\\"task-api-orders\\\"], \\\"resource_scope\\\": [\\\"release/\\\"], \\\"tracker_binding\\\": \\\"none\\\"}\\n{\\\"graph_node_id\\\": \\\"task-draft-idea\\\", \\\"artifact_kind\\\": \\\"task\\\", \\\"parent_feature\\\": null, \\\"status\\\": \\\"draft\\\", \\\"confirmation_status\\\": \\\"draft\\\", \\\"evaluation_status\\\": \\\"pending\\\", \\\"implementation_readiness\\\": {\\\"checked_at\\\": \\\"2026-09-07T05:00:00Z\\\", \\\"missing_sections\\\": [\\\"受入条件\\\", \\\"検証方法\\\"], \\\"status\\\": \\\"incomplete\\\"}, \\\"depends_on\\\": [], \\\"resource_scope\\\": [\\\"src/api/users/\\\"], \\\"tracker_binding\\\": \\\"none\\\"}\\n{\\\"graph_node_id\\\": \\\"task-unconfirmed-migration\\\", \\\"artifact_kind\\\": \\\"task\\\", \\\"parent_feature\\\": null, \\\"status\\\": \\\"draft\\\", \\\"confirmation_status\\\": \\\"draft\\\", \\\"evaluation_status\\\": \\\"pending\\\", \\\"implementation_readiness\\\": {\\\"checked_at\\\": \\\"2026-09-07T05:00:00Z\\\", \\\"missing_sections\\\": [], \\\"status\\\": \\\"complete\\\"}, \\\"depends_on\\\": [], \\\"resource_scope\\\": [\\\"src/db/migrations/\\\"], \\\"tracker_binding\\\": \\\"none\\\"}\\n{\\\"graph_node_id\\\": \\\"task-eval-failed-report\\\", \\\"artifact_kind\\\": \\\"task\\\", \\\"parent_feature\\\": null, \\\"sta