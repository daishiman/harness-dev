{"timestamp":"2026-11-02T06:00:37.722Z","ordinal":87,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a19ad7-c2e7-72e0-9d3e-fb30f46f36ee","turn_id":"01a19ad7-c502-71e1-a1bf-7d225b9b7af2","item":{"type":"CommandExecution","id":"exec-be505c66-82ce-4888-9d9b-142c1518446b","process_id":"46565","command":["/bin/zsh","-c","sed -n '440,505p' /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_c27_c28_projection_contract.py\ncat /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_schedule_transitive_dependencies.py"],"cwd":"file:///private/tmp/harness-codex-ci5-20261102/cases/schedule/fx","parsed_cmd":[{"type":"read","cmd":"sed -n '440,505p' /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_c27_c28_projection_contract.py","name":"test_c27_c28_projection_contract.py","path":"/private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_c27_c28_projection_contract.py"},{"type":"read","cmd":"cat /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_schedule_transitive_dependencies.py","name":"test_schedule_transitive_dependencies.py","path":"/private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_schedule_transitive_dependencies.py"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"    (config_dir / \"config.json\").write_text('{\"local_state\":{\"graph\":\"graph.json\"}}')\n    assert module._resolve_graph(tmp_path, None) == graph\n    (config_dir / \"config.json\").write_text(\"{}\")\n    with pytest.raises(module.ContractError, match=\"omits\"):\n        module._resolve_graph(tmp_path, None)\n    outside = tmp_path.parent / \"outside-c27.json\"; outside.write_text(\"{}\")\n    try:\n        with pytest.raises(module.ContractError, match=\"escapes\"):\n            module._resolve_graph(tmp_path, outside.as_posix())\n    finally:\n        outside.unlink()\n\n    consumer = tmp_path / \"consumer.py\"\n    consumer.write_text('print(\"{\\\\\"owner\\\\\":\\\\\"C02/run-dev-graph-node\\\\\",\\\\\"status\\\\\":\\\\\"applied\\\\\",\\\\\"graph_node_id\\\\\":\\\\\"G\\\\\",\\\\\"worktree_id\\\\\":\\\\\"wt_1111111111111111\\\\\"}\")')\n    lease = {\n        \"graph_node_id\": \"G\", \"worktree_id\": \"wt_\" + \"1\" * 16, \"branch\": \"devgraph/G\",\n        \"head_sha\": \"1\" * 40, \"created_at\": \"2026-07-13T00:00:00Z\", \"updated_at\": \"2026-07-13T00:00:01Z\",\n    }\n    ctx = {\"base_branch\": \"main\"}\n    assert module.invoke_execution_context_consumer(tmp_path, consumer, graph, lease, ctx)[\"status\"] == \"applied\"\n    consumer.write_text('print(\"not-json\")')\n    with pytest.raises(module.ContractError, match=\"invalid JSON\"):\n        module.invoke_execution_context_consumer(tmp_path, consumer, graph, lease, ctx)\n\n\ndef test_c27_fail_closed_owner_pending_release_and_projection_repair(tmp_path, monkeypatch, capsys):\n    module = load(SCRIPTS / \"manage-worktree-lease.py\", \"c27_fail_closed\")\n    common = tmp_path / \"common\"; common.mkdir()\n    ctx = {\n        \"repo_root\": str(tmp_path), \"git_common_dir\": str(common), \"repository_id\": \"R\",\n        \"worktree_id\": \"wt_\" + \"1\" * 16, \"branch\": \"devgraph/G\", \"base_branch\": \"main\", \"head_sha\": \"1\" * 40,\n    }\n    monkeypatch.setattr(module, \"context\", lambda root, resolver=None: dict(ctx))\n    monkeypatch.setattr(module, \"_ensure_claim_branch\", lambda root, node_id, requested, current: {**current, \"branch\": f\"devgraph/{node_id}\"})\n    graph = tmp_path / \"graph.json\"; graph.write_text('{\"nodes\": []}')\n    applied = lambda root, consumer, graph_path, lease, current: {\"owner\": \"C02/run-dev-graph-node\", \"status\": \"applied\", \"graph_node_id\": lease[\"graph_node_id\"], \"worktree_id\": lease[\"worktree_id\"]}\n    monkeypatch.setattr(module, \"invoke_execution_context_consumer\", applied)\n\n    claim = (\"--repo-root\", tmp_path, \"--op\", \"claim\", \"--graph\", graph, \"--graph-node-id\", \"G\", \"--session-id\", \"S\", \"--branch\", \"devgraph/G\")\n    call_main(module, monkeypatch, capsys, *claim)\n    with pytest.raises(module.ContractError, match=\"already has\"):\n        call_main(module, monkeypatch, capsys, \"--repo-root\", tmp_path, \"--op\", \"claim\", \"--graph\", graph, \"--graph-node-id\", \"G\", \"--session-id\", \"OTHER\")\n    call_main(module, monkeypatch, capsys, \"--repo-root\", tmp_path, \"--op\", \"park\", \"--graph-node-id\", \"G\", \"--session-id\", \"S\")\n    with pytest.raises(module.ContractError, match=\"system-release\"):\n        call_main(module, monkeypatch, capsys, \"--repo-root\", tmp_path, \"--op\", \"release\", \"--graph-node-id\", \"G\", \"--session-id\", \"S\")\n    with pytest.raises(module.ContractError, match=\"completion-event-key\"):\n        call_main(module, monkeypatch, capsys, \"--repo-root\", tmp_path, \"--op\", \"system-release\", \"--graph-node-id\", \"G\")\n\n    monkeypatch.setattr(module, \"invoke_execution_context_consumer\", lambda *a, **k: (_ for _ in ()).throw(module.ContractError(\"projection failed\")))\n    with pytest.raises(module.ContractError, match=\"projection failed\"):\n        call_main(module, monkeypatch, capsys, \"--repo-root\", tmp_path, \"--op\", \"claim\", \"--graph\", graph, \"--graph-node-id\", \"G2\", \"--session-id\", \"S2\")\n    ledger = json.loads((common / \"dev-graph\" / \"leases.json\").read_text())\n    repaired = next(row for row in ledger[\"leases\"] if row[\"graph_node_id\"] == \"G2\")\n    assert repaired[\"state\"] == \"claim_pending_local_repair\"\n\"\"\"schedule-graph puts a node in the ready set only when every dependency it reaches is done, not only the direct ones.\n\nrun-dev-graph-schedule's SKILL.md requires every ``depends_on`` to be done. A done or closed node can still\ndepend on an open one (C02 accepts ``status`` and ``depends_on`` patches, and C11 does not reject the pair),\nso a check of the direct dependencies alone let that node's dependents into the ready set. Two nodes with\nthe same id fail closed: building ``by_id`` would keep only the last one and hide the other.\n\"\"\"\nfrom __future__ import annotations\n\nimport importlib.util\nimport json\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\n\nPLUGIN = Path(__file__).resolve().parents[1]\nSCRIPTS = PLUGIN / \"scripts\"\nif str(SCRIPTS) not in sys.path:\n    sys.path.insert(0, str(SCRIPTS))\n\n\ndef load(script: str, module_name: str):\n    spec = importlib.util.spec_from_file_location(module_name, SCRIPTS / script)\n    assert spec and spec.loader\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[module_name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\ndef ready_node(node_id: str, **overrides):\n    node = {\n        \"id\": node_id,\n        \"artifact_kind\": \"task\",\n        \"status\": \"active\",\n        \"confirmation_status\": \"confirmed\",\n        \"evaluation_status\": \"pass\",\n        \"implementation_readiness\": {\"status\": \"complete\"},\n        \"depends_on\": [],\n        \"resource_scope\": [],\n    }\n    node.update(overrides)\n    return node\n\n\ndef schedule_args(tmp_path, nodes, ready_set=None):\n    graph = tmp_path / \"graph.json\"\n    graph.write_text(json.dumps({\"nodes\": nodes}), encoding=\"utf-8\")\n    args = [\"--graph\", graph]\n    if ready_set is not None:\n        ready = tmp_path / \"ready.json\"\n        ready.write_text(json.dumps({\"ready_set\": ready_set}), encoding=\"utf-8\")\n        args += [\"--ready-source\", \"bd-bridge\", \"--ready-json\", ready]\n    return args\n\n\ndef schedule(tmp_path, monkeypatch, capsys, nodes, ready_set=None):\n    module = load(\"schedule-graph.py\", \"schedule_graph_transitive_dependencies\")\n    monkeypatch.setattr(sys, \"argv\", [module.__file__, *map(str, schedule_args(tmp_path, nodes, ready_set))])\n    code = module.main()\n    return code, json.loads(capsys.readouterr().out.strip())\n\n\n@pytest.mark.parametrize((\"done_status\", \"open_status\"), [(\"done\", \"draft\"), (\"closed\", \"active\")])\ndef test_a_done_dependency_that_depends_on_an_open_node_keeps_its_dependent_out(\n    tmp_path, monkeypatch, capsys, done_status, open_status\n):\n    nodes = [\n        ready_node(\"upstream\", status=open_status, confirmation_status=\"draft\"),\n        ready_node(\"middle\", status=done_status, depends_on=[\"upstream\"]),\n        ready_node(\"leaf\", depends_on=[\"middle\"]),\n        ready_node(\"free\"),\n    ]\n\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes)\n\n    assert code == 0\n    assert report[\"ready_set\"][\"tasks\"] == [\"free\"]\n\n\ndef test_the_bd_bridge_ready_set_is_checked_through_the_same_transitive_rule(tmp_path, monkeypatch, capsys):\n    nodes = [\n        ready_node(\"upstream\", status=\"draft\", confirmation_status=\"draft\"),\n        ready_node(\"middle\", status=\"done\", depends_on=[\"upstream\"]),\n        ready_node(\"leaf\", depends_on=[\"middle\"]),\n        ready_node(\"free\"),\n    ]\n    ready_set = [{\"external_ref\": \"leaf\"}, {\"external_ref\": \"free\"}]\n\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes, ready_set)\n\n    assert code == 0\n    assert report[\"ready_set\"][\"tasks\"] == [\"free\"]\n    assert report[\"unmapped\"] == []\n\n\ndef test_a_chain_and_a_diamond_of_done_dependencies_still_schedule(tmp_path, monkeypatch, capsys):\n    nodes = [\n        ready_node(\"root\", status=\"done\"),\n        ready_node(\"left\", status=\"done\", depends_on=[\"root\"]),\n        ready_node(\"right\", status=\"closed\", depends_on=[\"root\"]),\n        ready_node(\"leaf\", depends_on=[\"left\", \"right\"]),\n    ]\n\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes)\n\n    assert code == 0\n    assert report[\"ready_set\"][\"tasks\"] == [\"leaf\"]\n\n\ndef test_a_dependency_missing_from_the_graph_keeps_its_dependent_out(tmp_path, monkeypatch, capsys):\n    nodes = [\n        ready_node(\"middle\", status=\"done\", depends_on=[\"ghost\"]),\n        ready_node(\"leaf\", depends_on=[\"middle\"]),\n        ready_node(\"orphan\", depends_on=[\"ghost\"]),\n    ]\n\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes)\n\n    assert code == 0\n    assert report[\"ready_set\"][\"tasks\"] == []\n\n\ndef test_cycles_end_and_keep_out_a_candidate_that_reaches_itself(tmp_path, monkeypatch, capsys):\n    # C11 rejects cycles, but schedule must not loop forever when handed one; ``seen`` ends the walk.\n    nodes = [\n        ready_node(\"loop-a\", depends_on=[\"loop-b\"]),\n        ready_node(\"loop-b\", status=\"done\", depends_on=[\"loop-a\"]),\n        ready_node(\"ring-x\", status=\"done\", depends_on=[\"ring-y\"]),\n        ready_node(\"ring-y\", status=\"done\", depends_on=[\"ring-x\"]),\n        ready_node(\"self-loop\", status=\"done\", depends_on=[\"self-loop\"]),\n        ready_node(\"after-ring\", depends_on=[\"ring-x\"]),\n        ready_node(\"after-self\", depends_on=[\"self-loop\"]),\n    ]\n\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes)\n\n    assert code == 0\n    assert report[\"ready_set\"][\"tasks\"] == [\"after-ring\", \"after-self\"]\n\n\ndef test_duplicate_node_ids_fail_closed(tmp_path, monkeypatch, capsys):\n    # With by_id built by a dict comprehension, the ready twin listed last hid the blocked one.\n    module = load(\"schedule-graph.py\", \"schedule_graph_transitive_dependencies\")\n    nodes = [\n        ready_node(\"upstream\", status=\"draft\", confirmation_status=\"draft\"),\n        ready_node(\"twin\", depends_on=[\"upstream\"]),\n        ready_node(\"twin\"),\n    ]\n    monkeypatch.setattr(sys, \"argv\", [module.__file__, *map(str, schedule_args(tmp_path, nodes))])\n\n    with pytest.raises(module.ContractError, match=r\"duplicate graph node ids: \\['twin'\\]\"):\n        module.main()\n    assert capsys.readouterr().out == \"\"\n","exit_code":0,"duration":{"secs":1,"nanos":369903417}},"started_at_ms":1793599236350,"completed_at_ms":1793599237720}}
{"timestamp":"2026-11-02T06:00:50.336Z","ordinal":88,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a19ad8-9fa0-7430-aa5b-7c6b72eec6c9","call_id":"call_73c2ed31f6e24da288ca35025c20a111","output":[{"type":"input_text","text":"Script completed\nWall time 14.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"f8525a\",\"wall_time_seconds\":1.368489417,\"exit_code\":0,\"original_token_count\":2468,\"output\":\"    (config_dir / \\\"config.json\\\").write_text('{\\\"local_state\\\":{\\\"graph\\\":\\\"graph.json\\\"}}')\\n    assert module._resolve_graph(tmp_path, None) == graph\\n    (config_dir / \\\"config.json\\\").write_text(\\\"{}\\\")\\n    with pytest.raises(module.ContractError, match=\\\"omits\\\"):\\n        module._resolve_graph(tmp_path, None)\\n    outside = tmp_path.parent / \\\"outside-c27.json\\\"; outside.write_text(\\\"{}\\\")\\n    try:\\n        with pytest.raises(module.ContractError, match=\\\"escapes\\\"):\\n            module._resolve_graph(tmp_path, outside.as_posix())\\n    finally:\\n        outside.unlink()\\n\\n    consumer = tmp_path / \\\"consumer.py\\\"\\n    consumer.write_text('print(\\\"{\\\\\\\\\\\"owner\\\\\\\\\\\":\\\\\\\\\\\"C02/run-dev-graph-node\\\\\\\\\\\",\\\\\\\\\\\"status\\\\\\\\\\\":\\\\\\\\\\\"applied\\\\\\\\\\\",\\\\\\\\\\\"graph_node_id\\\\\\\\\\\":\\\\\\\\\\\"G\\\\\\\\\\\",\\\\\\\\\\\"worktree_id\\\\\\\\\\\":\\\\\\\\\\\"wt_1111111111111111\\\\\\\\\\\"}\\\")')\\n    lease = {\\n        \\\"graph_node_id\\\": \\\"G\\\", \\\"worktree_id\\\": \\\"wt_\\\" + \\\"1\\\" * 16, \\\"branch\\\": \\\"devgraph/G\\\",\\n        \\\"head_sha\\\": \\\"1\\\" * 40, \\\"created_at\\\": \\\"2026-07-13T00:00:00Z\\\", \\\"updated_at\\\": \\\"2026-07-13T00:00:01Z\\\",\\n    }\\n    ctx = {\\\"base_branch\\\": \\\"main\\\"}\\n    assert module.invoke_execution_context_consumer(tmp_path, consumer, graph, lease, ctx)[\\\"status\\\"] == \\\"applied\\\"\\n    consumer.write_text('print(\\\"not-json\\\")')\\n    with pytest.raises(module.ContractError, match=\\\"invalid JSON\\\"):\\n        module.invoke_execution_context_consumer(tmp_path, consumer, graph, lease, ctx)\\n\\n\\ndef test_c27_fail_closed_owner_pending_release_and_projection_repair(tmp_path, monkeypatch, capsys):\\n    module = load(SCRIPTS / \\\"manage-worktree-lease.py\\\", \\\"c27_fail_closed\\\")\\n    common = tmp_path / \\\"common\\\"; common.mkdir()\\n    ctx = {\\n        \\\"repo_root\\\": str(tmp_path), \\\"git_common_dir\\\": str(common), \\\"repository_id\\\": \\\"R\\\",\\n        \\\"worktree_id\\\": \\\"wt_\\\" + \\\"1\\\" * 16, \\\"branch\\\": \\\"devgraph/G\\\", \\\"base_branch\\\": \\\"main\\\", \\\"head_sha\\\": \\\"1\\\" * 40,\\n    }\\n    monkeypatch.setattr(module, \\\"context\\\", lambda root, resolver=None: dict(ctx))\\n    monkeypatch.setattr(module, \\\"_ensure_claim_branch\\\", lambda root, node_id, requested, current: {**current, \\\"branch\\\": f\\\"devgraph/{node_id}\\\"})\\n    graph = tmp_path / \\\"graph.json\\\"; graph.write_text('{\\\"nodes\\\": []}')\\n    applied = lambda root, consumer, graph_path, lease, current: {\\\"owner\\\": \\\"C02/run-dev-graph-node\\\", \\\"status\\\": \\\"applied\\\", \\\"graph_node_id\\\": lease[\\\"graph_node_id\\\"], \\\"worktree_id\\\": lease[\\\"worktree_id\\\"]}\\n    monkeypatch.setattr(module, \\\"invoke_execution_context_consumer\\\", applied)\\n\\n    claim = (\\\"--repo-root\\\", tmp_path, \\\"--op\\\", \\\"claim\\\", \\\"--graph\\\", graph, \\\"--graph-node-id\\\", \\\"G\\\", \\\"--session-id\\\", \\\"S\\\", \\\"--branch\\\", \\\"devgraph/G\\\")\\n    call_main(module, monkeypatch, capsys, *claim)\\n    with pytest.raises(module.ContractError, match=\\\"already has\\\"):\\n        call_main(module, monkeypatch, capsys, \\\"--repo-root\\\", tmp_path, \\\"--op\\\", \\\"claim\\\", \\\"--graph\\\", graph, \\\"--graph-node-id\\\", \\\"G\\\", \\\"--session-id\\\", \\\"OTHER\\\")\\n    call_main(module, monkeypatch, capsys, \\\"--repo-root\\\", tmp_path, \\\"--op\\\", \\\"park\\\", \\\"--graph-node-id\\\", \\\"G\\\", \\\"--session-id\\\", \\\"S\\\")\\n    with pytest.raises(module.ContractError, match=\\\"system-release\\\"):\\n        call_main(module, monkeypatch, capsys, \\\"--repo-root\\\", tmp_path, \\\"--op\\\", \\\"release\\\", \\\"--graph-node-id\\\", \\\"G\\\", \\\"--session-id\\\", \\\"S\\\")\\n    with pytest.raises(module.ContractError, match=\\\"completion-event-key\\\"):\\n        call_main(module, monkeypatch, capsys, \\\"--repo-root\\\", tmp_path, \\\"--op\\\", \\\"system-release\\\", \\\"--graph-node-id\\\", \\\"G\\\")\\n\\n    monkeypatch.setattr(module, \\\"invoke_execution_context_consumer\\\", lambda *a, **k: (_ for _ in ()).throw(module.ContractError(\\\"projection failed\\\")))\\n    with pytest.raises(module.ContractError, match=\\\"projection failed\\\"):\\n        call_main(module, monkeypatch, capsys, \\\"--repo-root\\\", tmp_path, \\\"--op\\\", \\\"claim\\\", \\\"--graph\\\", graph, \\\"--graph-node-id\\\", \\\"G2\\\", \\\"--session-id\\\", \\\"S2\\\")\\n    ledger = json.loads((common / \\\"dev-graph\\\" / \\\"leases.json\\\").read_text())\\n    repaired = next(row for row in ledger[\\\"leases\\\"] if row[\\\"graph_node_id\\\"] == \\\"G2\\\")\\n    assert repaired[\\\"state\\\"] == \\\"claim_pending_local_repair\\\"\\n\\\"\\\"\\\"schedule-graph puts a node in the ready set only when every dependency it reaches is done, not only the direct ones.\\n\\nrun-dev-graph-schedule's SKILL.md requires every ``depends_on`` to be done. A done or closed node can still\\ndepend on an open one (C02 accepts ``status`` and ``depends_on`` patches, and C11 does not reject the pair),\\nso a check of the direct dependencies alone let that node's dependents into the ready set. Two nodes with\\nthe same id fail closed: building ``by_id`` would keep only the last one and hide the other.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport importlib.util\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\nimport pytest\\n\\n\\nPLUGIN = Path(__file__).resolve().parents[1]\\nSCRIPTS = PLUGIN / \\\"scripts\\\"\\nif str(SCRIPTS) not in sys.path:\\n    sys.path.insert(0, str(SCRIPTS))\\n\\n\\ndef load(script: str, module_name: str):\\n    spec = importlib.util.spec_from_file_location(module_name, SCRIPTS / script)\\n    assert spec and spec.loader\\n    module = importlib.util.module_from_spec(spec)\\n    sys.modules[module_name] = module\\n    spec.loader.exec_module(module)\\n    return module\\n\\n\\ndef ready_node(node_id: str, **overrides):\\n    node = {\\n        \\\"id\\\": node_id,\\n        \\\"artifact_kind\\\": \\\"task\\\",\\n        \\\"status\\\": \\\"active\\\",\\n        \\\"confirmation_status\\\": \\\"confirmed\\\",\\n        \\\"evaluation_status\\\": \\\"pass\\\",\\n        \\\"implementation_readiness\\\": {\\\"status\\\": \\\"complete\\\"},\\n        \\\"depends_on\\\": [],\\n        \\\"resource_scope\\\": [],\\n    }\\n    node.update(overrides)\\n    return node\\n\\n\\ndef schedule_args(tmp_path, nodes, ready_set=None):\\n    graph = tmp_path / \\\"graph.json\\\"\\n    graph.write_text(json.dumps({\\\"nodes\\\": nodes}), encoding=\\\"utf-8\\\")\\n    args = [\\\"--graph\\\", graph]\\n    if ready_set is not None:\\n        ready = tmp_path / \\\"ready.json\\\"\\n        ready.write_text(json.dumps({\\\"ready_set\\\": ready_set}), encoding=\\\"utf-8\\\")\\n        args += [\\\"--ready-source\\\", \\\"bd-bridge\\\", \\\"--ready-json\\\", ready]\\n    return args\\n\\n\\ndef schedule(tmp_path, monkeypatch, capsys, nodes, ready_set=None):\\n    module = load(\\\"schedule-graph.py\\\", \\\"schedule_graph_transitive_dependencies\\\")\\n    monkeypatch.setattr(sys, \\\"argv\\\", [module.__file__, *map(str, schedule_args(tmp_path, nodes, ready_set))])\\n    code = module.main()\\n    return code, json.loads(capsys.readouterr().out.strip())\\n\\n\\n@pytest.mark.parametrize((\\\"done_status\\\", \\\"open_status\\\"), [(\\\"done\\\", \\\"draft\\\"), (\\\"closed\\\", \\\"active\\\")])\\ndef test_a_done_dependency_that_depends_on_an_open_node_keeps_its_dependent_out(\\n    tmp_path, monkeypatch, capsys, done_status, open_status\\n):\\n    nodes = [\\n        ready_node(\\\"upstream\\\", status=open_status, confirmation_status=\\\"draft\\\"),\\n        ready_node(\\\"middle\\\", status=done_status, depends_on=[\\\"upstream\\\"]),\\n        ready_node(\\\"leaf\\\", depends_on=[\\\"middle\\\"]),\\n        ready_node(\\\"free\\\"),\\n    ]\\n\\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes)\\n\\n    assert code == 0\\n    assert report[\\\"ready_set\\\"][\\\"tasks\\\"] == [\\\"free\\\"]\\n\\n\\ndef test_the_bd_bridge_ready_set_is_checked_through_the_same_transitive_rule(tmp_path, monkeypatch, capsys):\\n    nodes = [\\n        ready_node(\\\"upstream\\\", status=\\\"draft\\\", confirmation_status=\\\"draft\\\"),\\n        ready_node(\\\"middle\\\", status=\\\"done\\\", depends_on=[\\\"upstream\\\"]),\\n        ready_node(\\\"leaf\\\", depends_on=[\\\"middle\\\"]),\\n        ready_node(\\\"free\\\"),\\n    ]\\n    ready_set = [{\\\"external_ref\\\": \\\"leaf\\\"}, {\\\"external_ref\\\": \\\"free\\\"}]\\n\\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes, ready_set)\\n\\n    assert code == 0\\n    assert report[\\\"ready_set\\\"][\\\"tasks\\\"] == [\\\"free\\\"]\\n    assert report[\\\"unmapped\\\"] == []\\n\\n\\ndef test_a_chain_and_a_diamond_of_done_dependencies_still_schedule(tmp_path, monkeypatch, capsys):\\n    nodes = [\\n        ready_node(\\\"root\\\", status=\\\"done\\\"),\\n        ready_node(\\\"left\\\", status=\\\"done\\\", depends_on=[\\\"root\\\"]),\\n        ready_node(\\\"right\\\", status=\\\"closed\\\", depends_on=[\\\"root\\\"]),\\n        ready_node(\\\"leaf\\\", depends_on=[\\\"left\\\", \\\"right\\\"]),\\n    ]\\n\\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes)\\n\\n    assert code == 0\\n    assert report[\\\"ready_set\\\"][\\\"tasks\\\"] == [\\\"leaf\\\"]\\n\\n\\ndef test_a_dependency_missing_from_the_graph_keeps_its_dependent_out(tmp_path, monkeypatch, capsys):\\n    nodes = [\\n        ready_node(\\\"middle\\\", status=\\\"done\\\", depends_on=[\\\"ghost\\\"]),\\n        ready_node(\\\"leaf\\\", depends_on=[\\\"middle\\\"]),\\n        ready_node(\\\"orphan\\\", depends_on=[\\\"ghost\\\"]),\\n    ]\\n\\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes)\\n\\n    assert code == 0\\n    assert report[\\\"ready_set\\\"][\\\"tasks\\\"] == []\\n\\n\\ndef test_cycles_end_and_keep_out_a_candidate_that_reaches_itself(tmp_path, monkeypatch, capsys):\\n    # C11 rejects cycles, but schedule must not loop forever when handed one; ``seen`` ends the walk.\\n    nodes = [\\n        ready_node(\\\"loop-a\\\", depends_on=[\\\"loop-b\\\"]),\\n        ready_node(\\\"loop-b\\\", status=\\\"done\\\", depends_on=[\\\"loop-a\\\"]),\\n        ready_node(\\\"ring-x\\\", status=\\\"done\\\", depends_on=[\\\"ring-y\\\"]),\\n        ready_node(\\\"ring-y\\\", status=\\\"done\\\", depends_on=[\\\"ring-x\\\"]),\\n        ready_node(\\\"self-loop\\\", status=\\\"done\\\", depends_on=[\\\"self-loop\\\"]),\\n        ready_node(\\\"after-ring\\\", depends_on=[\\\"ring-x\\\"]),\\n        ready_node(\\\"after-self\\\", depends_on=[\\\"self-loop\\\"]),\\n    ]\\n\\n    code, report = schedule(tmp_path, monkeypatch, capsys, nodes)\\n\\n    assert code == 0\\n    assert report[\\\"ready_set\\\"][\\\"tasks\\\"] == [\\\"after-ring\\\", \\\"after-self\\\"]\\n\\n\\ndef test_duplicate_node_ids_fail_closed(tmp_path, monkeypatch, capsys):\\n    # With by_id built by a dict comprehension, the ready twin listed last hid the blocked one.\\n    module = load(\\\"schedule-graph.py\\\", \\\"schedule_graph_transitive_dependencies\\\")\\n    nodes = [\\n        ready_node(\\\"upstream\\\", status=\\\"draft\\\", confirmation_status=\\\"draft\\\"),\\n        ready_node(\\\"twin\\\", depends_on=[\\\"upstream\\\"]),\\n        ready_node(\\\"twin\\\"),\\n    ]\\n    monkeypatch.setattr(sys, \\\"argv\\\", [module.__file__, *map(str, schedule_args(tmp_path, nodes))])\\n\\n    with pytest.raises(module.ContractError, match=r\\\"duplicate graph node ids: \\\\['twin'\\\\]\\\"):\\n        module.main()\\n    assert capsys.readouterr().out == \\\"\\\"\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"f39b8f\",\"wall_time_seconds\":11.517916084,\"session_id\":46853,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19ad7-c502-71e1-a1bf-7d225b9b7af2","create_time":1793599250.336622}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
