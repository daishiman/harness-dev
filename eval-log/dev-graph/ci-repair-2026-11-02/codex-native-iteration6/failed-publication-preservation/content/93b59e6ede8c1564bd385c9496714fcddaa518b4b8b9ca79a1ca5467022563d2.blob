{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -c \"rg -n 'user_choice_recorded|record-choice|choice_record|artifact-delivery-choice' /private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters | head -60\ncat /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/scripts/validate-graph-schema.py | tail -70\"","aggregated_output":"/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-governance-adapters/SKILL.md:33:    states: [artifact_created, minimal_guard_passed, artifact_presented, user_choice_recorded, semantic_evaluator_started, handoff_complete]\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-governance-adapters/SKILL.md:37:      - {from: artifact_presented, event: record_user_choice, to: user_choice_recorded}\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-governance-adapters/SKILL.md:38:      - {from: user_choice_recorded, event: accept-as-is, to: handoff_complete}\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-governance-adapters/SKILL.md:39:      - {from: user_choice_recorded, event: \"light|standard|detailed\", to: semantic_evaluator_started}\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-skill-feedback/SKILL.md:78:    states: [artifact_created, minimal_guard_passed, artifact_presented, user_choice_recorded, semantic_evaluator_started, handoff_complete]\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-skill-feedback/SKILL.md:82:      - {from: artifact_presented, event: record_user_choice, to: user_choice_recorded}\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-skill-feedback/SKILL.md:83:      - {from: user_choice_recorded, event: accept-as-is, to: handoff_complete}\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-skill-feedback/SKILL.md:84:      - {from: user_choice_recorded, event: \"light|standard|detailed\", to: semantic_evaluator_started}\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-skill-feedback/workflow-manifest.json:6:      \"states\": [\"artifact_created\", \"minimal_guard_passed\", \"artifact_presented\", \"user_choice_recorded\", \"semantic_evaluator_started\", \"handoff_complete\"],\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-skill-feedback/workflow-manifest.json:10:        {\"from\": \"artifact_presented\", \"event\": \"record_user_choice\", \"to\": \"user_choice_recorded\"},\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-skill-feedback/workflow-manifest.json:11:        {\"from\": \"user_choice_recorded\", \"event\": \"accept-as-is\", \"to\": \"handoff_complete\"},\n/private/tmp/harness-codex-ci5-20261102/providers/plugins/skill-governance-adapters/skills/run-skill-feedback/workflow-manifest.json:12:        {\"from\": \"user_choice_recorded\", \"event\": \"light|standard|detailed\", \"to\": \"semantic_evaluator_started\"},\n        # --graph FILE は contained(graph, root) を要求するため、preview を検証するには\n        # repo 内へ書くしかなく「dry-run write 0」契約と矛盾する。\n        if not args.repo_root:\n            raise ContractError(\"--repo-root is required when reading a preview graph from stdin\")\n        repo_root = Path(args.repo_root).expanduser().resolve(strict=True)\n        try:\n            document = json.loads(sys.stdin.read())\n        except json.JSONDecodeError as exc:\n            raise ContractError(f\"preview graph on stdin is not valid JSON: {exc}\") from exc\n    else:\n        graph = Path(args.graph).expanduser().resolve(strict=True)\n        repo_root = _repo_root_for(graph, args.repo_root)\n        document = load_json(graph)\n        canonical_store = _is_canonical_store(graph, repo_root)\n    nodes = nodes_of(document)\n    # stdin preview はまだ書いていない node を送ることが正当な用途 (decompose の dry-run) であり、\n    # ここで artifact_missing を fail させると preview 検証そのものが成立しない。\n    violations = validate(nodes, repo_root=repo_root, allow_missing_artifacts=is_stdin)\n    if canonical_store or args.require_canonical_envelope:\n        violations = sorted(violations + envelope_findings(document),\n                            key=lambda item: (item[\"node\"], item[\"code\"], item[\"detail\"]))\n    readiness = readiness_findings(nodes, repo_root, load_json(TEMPLATE_CONTRACT_PATH))\n    if args.strict_artifact_readiness:\n        violations = sorted(violations + readiness, key=lambda item: (item[\"node\"], item[\"code\"], item[\"detail\"]))\n    missing = readiness_missing_sections(violations)\n    dump({\n        \"valid\": not violations,\n        # 互換キー: 最上位の implementation_readiness/missing_sections は graph 全体の検証結果 (violations 0 件か) で、\n        # node の着手準備ではない。新しい読み手は graph_validation と node_readiness を読む。\n        \"implementation_readiness\": \"complete\" if not violations else \"incomplete\",\n        \"missing_sections\": missing,\n        \"graph_validation\": {\"status\": \"pass\" if not violations else \"fail\", \"violation_count\": len(violations)},\n        \"node_readiness\": node_readiness(nodes),\n        # 本文 readiness は既定で報告だけ。enforced=true のときだけ同じ finding が violations にも入る。\n        \"artifact_readiness\": {\n            \"status\": \"complete\" if not readiness else \"incomplete\",\n            \"enforced\": args.strict_artifact_readiness,\n            \"finding_count\": len(readiness),\n            \"missing_sections\": readiness_missing_sections(readiness),\n            \"findings\": readiness,\n        },\n        \"schema\": str(SCHEMA_PATH),\n        \"violations\": violations,\n    })\n    return 0 if not violations else 1\n\n\ndef node_readiness(nodes: list[Any]) -> dict[str, Any]:\n    \"\"\"各 node の implementation_readiness.status の集計。graph が valid でも node は incomplete でありうる。\"\"\"\n    counts = {\"complete\": 0, \"incomplete\": 0, \"not_applicable\": 0, \"unknown\": 0}\n    incomplete = []\n    for index, node in enumerate(nodes):\n        readiness = node.get(\"implementation_readiness\") if isinstance(node, dict) else None\n        raw = readiness.get(\"status\") if isinstance(readiness, dict) else None\n        status = raw if raw in {\"complete\", \"incomplete\", \"not_applicable\"} else \"unknown\"\n        counts[status] += 1\n        if status in {\"incomplete\", \"unknown\"}:\n            node_id = (node.get(\"graph_node_id\") or node.get(\"id\")) if isinstance(node, dict) else None\n            missing = readiness.get(\"missing_sections\") if isinstance(readiness, dict) else None\n            incomplete.append({\"graph_node_id\": node_id or f\"nodes[{index}]\", \"status\": status,\n                               \"missing_sections\": missing if isinstance(missing, list) else []})\n    return {**counts, \"incomplete_nodes\": incomplete}\n\n\nif __name__ == \"__main__\":\n    try:\n        raise SystemExit(main())\n    except (ContractError, OSError) as exc:\n        print(str(exc), file=sys.stderr)\n        raise SystemExit(2)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -c \"/usr/bin/arch -x86_64 /Library/Frameworks/Python.framework/Versions/3.11/bin/python3 -B - <<'PY'\nimport json,hashlib,datetime\nfrom pathlib import Path\nr=Path('/private/tmp/harness-codex-ci5-20261102/cases/schedule/fx'); out=r/'eval-log'; out.mkdir(exist_ok=True)\nreq=json.loads((r/'artifact-choice-request.json').read_text())\nfor a in req['artifacts']: assert hashlib.sha256(Path(a['path']).read_bytes()).hexdigest()==a['sha256']\nchoice={**req,'state':'user_choice_recorded','choice':'standard','user_message':'standard','recorded_at':datetime.datetime.now(datetime.timezone.utc).isoformat()}\n(out/'run-dev-graph-schedule-artifact-choice.json').write_text(json.dumps(choice,ensure_ascii=False,indent=2)+'\\\\n')\ngoal='グラフの依存関係・完了状態・active worktree leaseから次に着手すべきready-setと、リソーススコープ/lease重複のない複数worktree向け並列バッチを算出・提示した状態になっている'\n(out/'run-dev-graph-schedule-goal-spec.json').write_text(json.dumps({'original_goal':goal,'scope':'all','max_parallel':4,'invocation_id':req['invocation_id']},ensure_ascii=False,indent=2)+'\\\\n')\n(out/'run-dev-graph-schedule-progress.json').write_text(json.dumps({'state':'semantic_evaluator_started','choice':'standard','checklist':{'candidate_eligibility':'pending','separate_batches':'pending','resource_safety':'pending','assignment_hints':'pending','input_immutability':'pending'}},ensure_ascii=False,indent=2)+'\\\\n')\nprint('選択記録とgoal/progressを保存しました')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -c \"/usr/bin/arch -x86_64 /Library/Frameworks/Python.framework/Versions/3.11/bin/python3 -B - <<'PY'\nimport json,hashlib,datetime\nfrom pathlib import Path\nr=Path('/private/tmp/harness-codex-ci5-20261102/cases/schedule/fx'); out=r/'eval-log'; out.mkdir(exist_ok=True)\nreq=json.loads((r/'artifact-choice-request.json').read_text())\nfor a in req['artifacts']: assert hashlib.sha256(Path(a['path']).read_bytes()).hexdigest()==a['sha256']\nchoice={**req,'state':'user_choice_recorded','choice':'standard','user_message':'standard','recorded_at':datetime.datetime.now(datetime.timezone.utc).isoformat()}\n(out/'run-dev-graph-schedule-artifact-choice.json').write_text(json.dumps(choice,ensure_ascii=False,indent=2)+'\\\\n')\ngoal='グラフの依存関係・完了状態・active worktree leaseから次に着手すべきready-setと、リソーススコープ/lease重複のない複数worktree向け並列バッチを算出・提示した状態になっている'\n(out/'run-dev-graph-schedule-goal-spec.json').write_text(json.dumps({'original_goal':goal,'scope':'all','max_parallel':4,'invocation_id':req['invocation_id']},ensure_ascii=False,indent=2)+'\\\\n')\n(out/'run-dev-graph-schedule-progress.json').write_text(json.dumps({'state':'semantic_evaluator_started','choice':'standard','checklist':{'candidate_eligibility':'pending','separate_batches':'pending','resource_safety':'pending','assignment_hints':'pending','input_immutability':'pending'}},ensure_ascii=False,indent=2)+'\\\\n')\nprint('選択記録とgoal/progressを保存しました')\nPY\"","aggregated_output":"選択記録とgoal/progressを保存しました\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -c \"rg --files /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests | rg 'lease|claim|worktree'\ncat /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_schedule_binding_expiry_scope_max_parallel.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -c \"rg --files /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests | rg 'lease|claim|worktree'\ncat /private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_schedule_binding_expiry_scope_max_parallel.py\"","aggregated_output":"/private/tmp/harness-codex-ci5-20261102/providers/plugins/dev-graph/tests/test_worktree_lease_readonly.py\n\"\"\"schedule-graph.py の binding 別 ready 判定・lease 期限・--scope・--max-parallel・入力不変の検証。\n\nbd-bridge mode では tracker_binding ごとに ready の根拠が違う。beads は C28 の ready entry と\n確認済み edge parity、github/none は graph だけで決める。lease は manage-worktree-lease.py と\n同じ state で expires_at を読み、期限で解放される claim が scope を塞ぎ続けないようにする。\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport json\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nsys.dont_write_bytecode = True\n\nPLUGIN = Path(__file__).resolve().parents[1]\nSCRIPTS = PLUGIN / \"scripts\"\nif str(SCRIPTS) not in sys.path:\n    sys.path.insert(0, str(SCRIPTS))\n\n\ndef load(script: str, name: str):\n    spec = importlib.util.spec_from_file_location(name, SCRIPTS / script)\n    assert spec and spec.loader\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\ndef call_main(module, monkeypatch, capsys, *argv):\n    monkeypatch.setattr(sys, \"argv\", [str(module.__file__), *map(str, argv)])\n    code = module.main()\n    output = capsys.readouterr().out.strip()\n    return code, json.loads(output) if output else None\n\n\nBASE = {\n    \"artifact_kind\": \"task\", \"status\": \"active\", \"confirmation_status\": \"confirmed\",\n    \"evaluation_status\": \"pass\", \"implementation_readiness\": {\"status\": \"complete\"},\n    \"depends_on\": [],\n}\n\n\ndef write_graph(path: Path, nodes: list[dict]) -> None:\n    path.write_text(json.dumps({\"schema_version\": \"1.0.0\", \"graph_revision\": 1, \"nodes\": nodes}), encoding=\"utf-8\")\n\n\ndef test_schedule_mixed_binding_parity_expiry_and_max_parallel(tmp_path, monkeypatch, capsys):\n    schedule = load(\"schedule-graph.py\", \"schedule_v2_contract\")\n    graph = tmp_path / \"graph.json\"\n    write_graph(graph, [\n        {**BASE, \"graph_node_id\": \"beads\", \"tracker_binding\": \"beads\", \"resource_scope\": [\"a\"]},\n        {**BASE, \"graph_node_id\": \"github\", \"tracker_binding\": \"github\", \"resource_scope\": [\"b\"]},\n        {**BASE, \"graph_node_id\": \"none\", \"tracker_binding\": \"none\", \"resource_scope\": [\"c\"]},\n    ])\n    ready = tmp_path / \"ready.json\"\n    ready.write_text(json.dumps({\"ready_set\": [{\n        \"bd_issue_id\": \"bd-1\", \"external_ref\": \"beads\", \"edge_parity\": {\"confirmed\": True},\n        \"graph_status\": \"active\", \"graph_depends_on\": [],\n    }]}), encoding=\"utf-8\")\n    leases = tmp_path / \"leases.json\"\n    leases.write_text(json.dumps({\"leases\": [{\n        \"graph_node_id\": \"github\", \"state\": \"claimed\", \"resource_scope\": [\"b\"],\n        \"expires_at\": \"2020-01-01T00:00:00Z\",\n    }]}), encoding=\"utf-8\")\n    argv = (\"--graph\", graph, \"--ready-source\", \"bd-bridge\", \"--ready-json\", ready, \"--leases\", leases)\n\n    code, plan = call_main(schedule, monkeypatch, capsys, *argv, \"--max-parallel\", \"1\")\n\n    assert code == 0\n    # github/none は Beads の ready entry を持たなくても graph だけで ready になる。\n    # 2020 年に期限の切れた claimed lease は github を塞がない。\n    assert plan[\"ready_set\"][\"tasks\"] == [\"beads\", \"github\", \"none\"]\n    assert plan[\"conflicts\"] == [] and plan[\"excluded\"] == []\n    assert plan[\"batches\"][\"tasks\"] == [[\"beads\"], [\"github\"], [\"none\"]]\n    assert plan[\"max_parallel\"] == 1 and plan[\"read_only\"] is True\n    assert plan[\"graph_sha256_before\"] == plan[\"graph_sha256_after\"]\n    assert plan[\"tracker_sha256_before\"] == plan[\"tracker_sha256_after\"] is not None\n    assert plan[\"lease_sha256_before\"] == plan[\"lease_sha256_after\"] is not None\n\n    _, unbounded = call_main(schedule, monkeypatch, capsys, *argv)\n    assert unbounded[\"batches\"][\"tasks\"] == [[\"beads\", \"github\", \"none\"]]\n\n    ready.write_text(json.dumps({\"ready_set\": [{\n        \"bd_issue_id\": \"bd-1\", \"external_ref\": \"beads\", \"edge_parity\": {\"confirmed\": True},\n        \"graph_status\": \"active\", \"graph_depends_on\": [\"stale-dependency\"],\n    }]}), encoding=\"utf-8\")\n    _, stale = call_main(schedule, monkeypatch, capsys, *argv)\n    assert stale[\"ready_set\"][\"tasks\"] == [\"github\", \"none\"]\n    assert [row[\"reason\"] for row in stale[\"excluded\"]] == [\"beads_parity_stale_or_unconfirmed\"]\n\n\ndef test_lease_expiry_follows_the_lease_manager_states(tmp_path, monkeypatch, capsys):\n    \"\"\"期限で解放される state だけが expires_at で非 active になる。park 後の pending_review は残る。\"\"\"\n    schedule = load(\"schedule-graph.py\", \"schedule_v2_lease_expiry\")\n    graph = tmp_path / \"graph.json\"\n    write_graph(graph, [\n        {**BASE, \"graph_node_id\": \"parked\", \"resource_scope\": [\"parked\"]},\n        {**BASE, \"graph_node_id\": \"running\", \"resource_scope\": [\"running\"]},\n        {**BASE, \"graph_node_id\": \"stale\", \"resource_scope\": [\"stale\"]},\n    ])\n    leases = tmp_path / \"leases.json\"\n    leases.write_text(json.dumps({\"leases\": [\n        {\"graph_node_id\": \"parked\", \"state\": \"pending_review\", \"resource_scope\": [], \"expires_at\": \"2020-01-01T00:00:00Z\"},\n        {\"graph_node_id\": \"running\", \"state\": \"in_progress\", \"resource_scope\": [], \"expires_at\": \"2099-01-01T00:00:00Z\"},\n        {\"graph_node_id\": \"stale\", \"state\": \"in_progress\", \"resource_scope\": [], \"expires_at\": \"2020-01-01T00:00:00Z\"},\n    ]}), encoding=\"utf-8\")\n\n    code, plan = call_main(schedule, monkeypatch, capsys, \"--graph\", graph, \"--leases\", leases)\n\n    assert code == 0\n    assert plan[\"ready_set\"][\"tasks\"] == [\"stale\"]\n    assert plan[\"conflicts\"] == [\"parked\", \"running\"]\n\n    for expires, message in ((\"not-a-time\", \"invalid expires_at\"), (\"2099-01-01T00:00:00\", \"timezone-aware\")):\n        leases.write_text(json.dumps({\"leases\": [\n            {\"graph_node_id\": \"running\", \"state\": \"claimed\", \"resource_scope\": [], \"expires_at\": expires},\n        ]}), encoding=\"utf-8\")\n        with pytest.raises(schedule.ContractError, match=message):\n            call_main(schedule, monkeypatch, capsys, \"--graph\", graph, \"--leases\", leases)\n\n\ndef test_scope_selects_the_feature_subtree_and_max_parallel_must_be_positive(tmp_path, monkeypatch, capsys):\n    schedule = load(\"schedule-graph.py\", \"schedule_v2_scope\")\n    graph = tmp_path / \"graph.json\"\n    write_graph(graph, [\n        {**BASE, \"graph_node_id\": \"feature-a\", \"artifact_kind\": \"feature\", \"resource_scope\": [\"a\"]},\n        {**BASE, \"graph_node_id\": \"a-task\", \"parent_feature\": \"feature-a\", \"resource_scope\": [\"a/task\"]},\n        {**BASE, \"graph_node_id\": \"b-task\", \"parent_feature\": \"feature-b\", \"resource_scope\": [\"b/task\"]},\n        {**BASE, \"graph_node_id\": \"feature-b\", \"artifact_kind\": \"feature\", \"resource_scope\": [\"b\"]},\n    ])\n\n    _, scoped = call_main(schedule, monkeypatch, capsys, \"--graph\", graph, \"--scope\", \"feature-a\")\n    # 配下 task がある feature は計画済みとして分離し、planner を再起動する候補にはしない。\n    assert scoped[\"ready_set\"] == {\"features\": [], \"tasks\": [\"a-task\"]}\n    assert scoped[\"planned_features\"] == [\"feature-a\"]\n    assert scoped[\"batches\"] == {\"features\": [], \"tasks\": [[\"a-task\"]]}\n    # scope 内の ready node が共有する path の診断は、計画済み feature についても残す。\n    assert scoped[\"conflict_pairs\"] == [\n        {\"left\": \"a-task\", \"right\": \"feature-a\", \"kind\": \"ready_pair\", \"resources\": [\"a/task\"]},\n    ]\n\n    with pytest.raises(schedule.ContractError, match=\"--max-parallel must be at least 1\"):\n        call_main(schedule, monkeypatch, capsys, \"--graph\", graph, \"--max-parallel\", \"0\")\n","exit_code":0,"status":"completed"}}
